.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 60rpx;
}

.cat-scroll {
  white-space: nowrap;
}

.cat-list {
  display: inline-flex;
}

.cat-item {
  font-size: 24rpx;
  color: #8a8a9a;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  margin-right: 16rpx;
  background-color: rgba(255, 255, 255, 0.05);
  flex-shrink: 0;
}

.cat-item.active {
  color: #00d4ff;
  background-color: rgba(0, 212, 255, 0.15);
  border: 1rpx solid rgba(0, 212, 255, 0.35);
}

.result-count {
  font-size: 21rpx;
  color: #6a6a7a;
  font-family: monospace;
  margin: 28rpx 0 16rpx;
}

.video-card {
  margin-bottom: 32rpx;
  background-color: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  overflow: hidden;
}

.video-card:active {
  background-color: rgba(0, 212, 255, 0.06);
}

.thumb {
  position: relative;
  width: 100%;
  height: 340rpx;
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
  background-color: #15152a;
}

.thumb-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.22);
}

.play-btn {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background-color: rgba(0, 212, 255, 0.2);
  border: 2rpx solid rgba(0, 212, 255, 0.75);
  box-shadow: 0 0 24rpx rgba(0, 212, 255, 0.35);
  color: #00d4ff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.duration {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  font-size: 20rpx;
  color: #ffffff;
  background-color: rgba(0, 0, 0, 0.65);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-family: monospace;
}

.thumb-corner {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border-color: rgba(0, 212, 255, 0.8);
  border-style: solid;
  z-index: 2;
}

.thumb-corner.tl { top: 12rpx; left: 12rpx; border-width: 2rpx 0 0 2rpx; }
.thumb-corner.br { bottom: 12rpx; right: 12rpx; border-width: 0 2rpx 2rpx 0; }

.video-info {
  padding: 24rpx;
}

.video-meta {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.video-date {
  font-size: 20rpx;
  color: #6a6a7a;
}

.video-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.video-views {
  display: block;
  font-size: 22rpx;
  color: #8a8a9a;
}

.player-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.player-box {
  width: 100%;
  padding: 24rpx;
}

.player {
  width: 100%;
  height: 420rpx;
}

.player-close {
  text-align: center;
  font-size: 26rpx;
  color: #00d4ff;
  padding: 28rpx;
}
