page {
  background: #0a0a14;
}

.page {
  min-height: 100vh;
  padding: 0 30rpx 60rpx;
  box-sizing: border-box;
  color: #ffffff;
  background:
    radial-gradient(circle at 88% -8%, rgba(255, 45, 149, 0.16), transparent 48%),
    radial-gradient(circle at 4% 18%, rgba(168, 85, 247, 0.08), transparent 44%),
    #0a0a14;
}

/* Hero */
.hero {
  padding: 54rpx 8rpx 30rpx;
}

.hero-kicker {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #ff2d95;
}

.hero-title {
  margin-top: 14rpx;
  font-size: 62rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8d95ad;
}

/* 输入面板 */
.panel {
  padding: 32rpx 26rpx 28rpx;
  border: 1rpx solid rgba(255, 45, 149, 0.22);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.035);
}

.section-en {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #ff2d95;
}

.people-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 22rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  background: rgba(10, 16, 30, 0.6);
}

.input-label {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #c9d2e6;
}

.step-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border: 1rpx solid rgba(255, 45, 149, 0.35);
  border-radius: 12rpx;
  color: #ff2d95;
  font-size: 32rpx;
}

.people-input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  text-align: center;
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
}

.input-placeholder {
  font-size: 24rpx;
  font-weight: 400;
  color: #5c6780;
}

.input-unit {
  flex-shrink: 0;
  font-size: 19rpx;
  color: #8d95ad;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.quick-chip {
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.03);
  font-size: 21rpx;
  color: #a7b0c6;
}

.quick-chip.active {
  border-color: rgba(255, 45, 149, 0.5);
  background: rgba(255, 45, 149, 0.14);
  color: #ff7ab9;
}

.scene-title {
  margin-top: 34rpx;
}

.scene-row {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.scene-btn {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  padding: 18rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.03);
}

.scene-btn.active {
  border-color: #ff2d95;
  background: rgba(255, 45, 149, 0.14);
}

.scene-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #eef2ff;
}

.scene-btn.active .scene-name {
  color: #ff7ab9;
}

.scene-hint {
  font-size: 18rpx;
  line-height: 1.5;
  color: #8d95ad;
}

.input-hint {
  margin-top: 18rpx;
  font-size: 20rpx;
  line-height: 1.7;
  color: #7f8aa3;
}

/* 推荐结果 */
.result-card {
  margin-top: 34rpx;
  padding: 40rpx 30rpx 32rpx;
  border: 1rpx solid rgba(255, 45, 149, 0.38);
  border-radius: 24rpx;
  background: linear-gradient(150deg, rgba(255, 45, 149, 0.18), rgba(14, 22, 40, 0.95));
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.25);
}

.result-eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #ff7ab9;
}

.result-number {
  margin-top: 12rpx;
  font-size: 106rpx;
  font-weight: 800;
  line-height: 1.2;
}

.result-unit {
  margin-left: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #c9d2e6;
}

.result-summary {
  display: block;
  font-size: 24rpx;
  color: #eef2ff;
}

.result-formula {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #a7b0c6;
}

.result-grid {
  display: flex;
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
}

.result-cell {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.cell-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff7ab9;
}

.cell-label {
  font-size: 20rpx;
  color: #a7b0c6;
}

.table-note {
  margin-top: 26rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 45, 149, 0.1);
  font-size: 20rpx;
  line-height: 1.6;
  color: #ffb3d5;
}

/* 区块标题 */
.section-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin: 40rpx 8rpx 18rpx;
}

.section-cn {
  font-size: 22rpx;
  color: #8d95ad;
}

/* 菜类明细 */
.category-list {
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.035);
  overflow: hidden;
}

.category-row {
  padding: 24rpx 24rpx 22rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
}

.category-row:last-child {
  border-bottom: none;
}

.category-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.category-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #eef2ff;
}

.category-count {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 45, 149, 0.14);
  font-size: 22rpx;
  font-weight: 700;
  color: #ff7ab9;
}

.category-count.zero {
  background: rgba(255, 255, 255, 0.05);
  color: #7f8aa3;
}

.category-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: #8d95ad;
}

/* 搭配原则 */
.tips-card {
  padding: 10rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.035);
}

.tip-row {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.tip-row:last-child {
  border-bottom: none;
}

.tip-no {
  flex-shrink: 0;
  font-family: monospace;
  font-size: 22rpx;
  color: #ff2d95;
}

.tip-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.7;
  color: #c9d2e6;
}

/* 操作 */
.actions {
  display: flex;
  gap: 18rpx;
  margin-top: 36rpx;
}

.primary-btn,
.ghost-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.primary-btn {
  background: linear-gradient(90deg, #ff2d95, #a855f7);
  color: #ffffff;
}

.ghost-btn {
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  color: #c9d2e6;
}

/* 空态 */
.empty-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 34rpx;
  padding: 50rpx 30rpx;
  border: 1rpx dashed rgba(255, 45, 149, 0.3);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.025);
  text-align: center;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ff7ab9;
}

.empty-text {
  font-size: 21rpx;
  line-height: 1.8;
  color: #8d95ad;
}

.foot-note {
  margin-top: 40rpx;
  font-size: 19rpx;
  line-height: 1.8;
  color: #626c85;
  text-align: center;
}
