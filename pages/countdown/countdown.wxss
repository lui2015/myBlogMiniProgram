.page {
  min-height: 100vh;
  padding-bottom: 80rpx;
}

.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx 44rpx;
  overflow: hidden;
  background: radial-gradient(ellipse at 50% 0%, #141a33 0%, #0a0a14 78%);
}

.hero-grid {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx);
  background-size: 44rpx 44rpx;
}

.hero-title {
  position: relative;
  font-size: 58rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  color: #ffffff;
  text-shadow: -4rpx 0 #ff2d95, 4rpx 0 #00d4ff;
}

.hero-sub {
  position: relative;
  font-size: 21rpx;
  color: #7a7a96;
  font-family: monospace;
  margin-top: 14rpx;
}

.add-btn {
  position: relative;
  margin-top: 32rpx;
  padding: 18rpx 44rpx;
  font-size: 25rpx;
  color: #00d4ff;
  background-color: rgba(0, 212, 255, 0.08);
  border: 1rpx solid rgba(0, 212, 255, 0.4);
  border-radius: 40rpx;
}

.add-btn:active {
  background-color: rgba(0, 212, 255, 0.22);
}

.list-head {
  display: flex;
  align-items: center;
  margin: 40rpx 32rpx 24rpx;
}

.sec-icon {
  font-size: 26rpx;
  color: #00d4ff;
  margin-right: 12rpx;
}

.sec-title {
  font-size: 23rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 3rpx;
  font-family: monospace;
}

.head-count {
  margin-left: auto;
  font-size: 20rpx;
  color: #6a6a7a;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 27rpx;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 22rpx;
  color: #6a6a7a;
}

/* 事件卡片 */
.event-list {
  padding: 0 32rpx;
}

.event-card {
  position: relative;
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.015));
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-left: 5rpx solid #00d4ff;
  border-radius: 14rpx;
}

.event-card.past {
  opacity: 0.65;
}

.ev-icon-wrap {
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  margin-right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid #00d4ff;
  border-radius: 14rpx;
}

.ev-icon {
  font-size: 40rpx;
}

.ev-body {
  flex: 1;
  min-width: 0;
}

.ev-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ev-date {
  display: block;
  font-size: 20rpx;
  color: #8a8a9a;
  margin-bottom: 8rpx;
}

.ev-status {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.ev-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 16rpx;
  margin-right: 24rpx;
}

.ev-number {
  font-size: 46rpx;
  font-weight: bold;
  font-family: monospace;
  line-height: 1.1;
}

.ev-unit {
  font-size: 18rpx;
  color: #6a6a7a;
  margin-top: 4rpx;
}

.ev-delete {
  position: absolute;
  top: 10rpx;
  right: 14rpx;
  font-size: 22rpx;
  color: #5a5a6a;
  padding: 8rpx;
}

.ev-delete:active {
  color: #ff2d95;
}

.tip {
  margin: 36rpx 32rpx 0;
  padding: 24rpx;
  background-color: rgba(168, 85, 247, 0.04);
  border: 1rpx solid rgba(168, 85, 247, 0.15);
  border-radius: 12rpx;
}

.tip-text {
  font-size: 21rpx;
  color: #8a8a9a;
  line-height: 1.8;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 200;
  background-color: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.modal {
  width: 100%;
  max-height: 82vh;
  padding: 36rpx 32rpx;
  background: linear-gradient(160deg, #151a30, #0d1020);
  border: 1rpx solid rgba(0, 212, 255, 0.3);
  border-radius: 18rpx;
  box-sizing: border-box;
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 22rpx;
  color: #8a8a9a;
  margin: 24rpx 0 12rpx;
}

.form-input {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  font-size: 25rpx;
  color: #ffffff;
  background-color: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(0, 212, 255, 0.2);
  border-radius: 10rpx;
  box-sizing: border-box;
}

.input-ph {
  color: #5a5a6a;
}

.mode-seg {
  display: flex;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 23rpx;
  color: #8a8a9a;
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  margin-right: 16rpx;
  border-radius: 10rpx;
}

.seg-item:last-child {
  margin-right: 0;
}

.seg-item.active {
  color: #00d4ff;
  background-color: rgba(0, 212, 255, 0.12);
  border-color: rgba(0, 212, 255, 0.4);
}

.icon-grid {
  display: flex;
  flex-wrap: wrap;
}

.icon-item {
  width: 14.28%;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border: 1rpx solid transparent;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.icon-item.active {
  border-color: #00d4ff;
  background-color: rgba(0, 212, 255, 0.15);
}

.theme-row {
  display: flex;
}

.theme-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
  margin-right: 14rpx;
  font-size: 20rpx;
  color: #8a8a9a;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 10rpx;
}

.theme-item:last-child {
  margin-right: 0;
}

.theme-item.active {
  border-color: #00d4ff;
  color: #ffffff;
}

.theme-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  margin-bottom: 8rpx;
}

.modal-actions {
  display: flex;
  margin-top: 40rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 25rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.modal-btn:last-child {
  margin-right: 0;
}

.modal-btn.cancel {
  color: #8a8a9a;
  background-color: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.modal-btn.confirm {
  color: #0a0a14;
  font-weight: bold;
  background: linear-gradient(90deg, #00d4ff, #a855f7);
}
