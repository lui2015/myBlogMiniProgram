.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 60rpx;
}

.page-hint {
  font-size: 21rpx;
  color: #6a6a7a;
  font-family: monospace;
  letter-spacing: 1rpx;
  margin-bottom: 24rpx;
}

.album-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.album-card {
  position: relative;
  width: 48%;
  height: 300rpx;
  margin-bottom: 24rpx;
  border-radius: 14rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 212, 255, 0.14);
}

.album-card:active {
  opacity: 0.85;
}

.album-cover {
  width: 100%;
  height: 100%;
  display: block;
  background-color: #15152a;
}

.album-mask {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 55%;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.9));
}

.album-info {
  position: absolute;
  left: 20rpx; right: 20rpx; bottom: 20rpx;
}

.album-name {
  display: block;
  font-size: 28rpx;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.album-count {
  display: block;
  font-size: 21rpx;
  color: #00d4ff;
  font-family: monospace;
}

.album-corner {
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  border-color: rgba(0, 212, 255, 0.8);
  border-style: solid;
  z-index: 2;
}

.album-corner.tl { top: 10rpx; left: 10rpx; border-width: 2rpx 0 0 2rpx; }
.album-corner.br { bottom: 10rpx; right: 10rpx; border-width: 0 2rpx 2rpx 0; }
