<view class="page">

  <view class="hero">
    <view class="hero-grid"></view>
    <text class="hero-title">SOFTWARE</text>
    <text class="hero-sub">// 软件作品</text>
    <view class="hero-line"></view>
  </view>

  <view class="list-head">
    <text class="sec-icon">◈</text>
    <text class="count-text">共 {{softwares.length}} 个作品</text>
    <view class="sec-line"></view>
  </view>

  <view wx:if="{{loading}}" class="state"><text class="state-text">正在加载…</text></view>

  <view wx:elif="{{error}}" class="state">
    <text class="state-text">{{error}}</text>
    <view class="state-retry" bindtap="onRetry">重新加载</view>
  </view>

  <view wx:elif="{{!softwares.length}}" class="state">
    <text class="state-text">暂无软件作品</text>
  </view>

  <view wx:else class="grid">
    <view
      class="card"
      wx:for="{{softwares}}"
      wx:key="id"
      bindtap="onCardTap"
      data-id="{{item.id}}"
    >
      <view class="card-img-wrap">
        <image class="card-img" src="{{item.image}}" mode="aspectFill" lazy-load></image>
        <text class="card-badge">软件</text>
        <view class="card-corner tl"></view>
      </view>
      <view class="card-body">
        <text class="card-name">{{item.name}}</text>
        <text class="card-desc">{{item.description}}</text>
        <text class="card-action">查看作品 ↗</text>
      </view>
    </view>
    <view class="list-end">— 全部作品 —</view>
  </view>

  <!-- 作品详情弹层 -->
  <view wx:if="{{detail}}" class="mask" bindtap="closeDetail">
    <scroll-view class="sheet" scroll-y catchtap="noop">
      <image wx:if="{{detail.image}}" class="sheet-cover" src="{{detail.image}}" mode="widthFix" bindtap="previewCover" lazy-load></image>
      <view class="sheet-body">
        <text class="sheet-name">{{detail.name}}</text>
        <text wx:if="{{detail.description}}" class="sheet-desc">{{detail.description}}</text>
        <text wx:else class="sheet-desc">暂无介绍</text>
        <view class="sheet-actions">
          <view class="sheet-btn" bindtap="copyUrl">复制地址</view>
          <view class="sheet-btn ghost" bindtap="closeDetail">关闭</view>
        </view>
        <text class="sheet-hint">点击封面可查看大图</text>
      </view>
    </scroll-view>
  </view>

</view>
