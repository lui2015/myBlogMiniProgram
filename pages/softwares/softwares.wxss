.page {
  min-height: 100vh;
  padding-bottom: 80rpx;
}

.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 52rpx 32rpx 40rpx;
  overflow: hidden;
  background: radial-gradient(ellipse at 50% 0%, #141a33 0%, #0a0a14 78%);
}

.hero-grid {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx);
  background-size: 44rpx 44rpx;
}

.hero-title {
  position: relative;
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  color: #ffffff;
  text-shadow: -4rpx 0 #ff2d95, 4rpx 0 #00d4ff;
}

.hero-sub {
  position: relative;
  font-size: 21rpx;
  color: #7a7a96;
  font-family: monospace;
  margin-top: 14rpx;
}

.hero-line {
  position: relative;
  width: 140rpx;
  height: 2rpx;
  margin-top: 26rpx;
  background: linear-gradient(90deg, transparent, #00d4ff, transparent);
}

.list-head {
  display: flex;
  align-items: center;
  margin: 36rpx 32rpx 24rpx;
}

.sec-icon {
  font-size: 26rpx;
  color: #00d4ff;
  margin-right: 12rpx;
}

.count-text {
  font-size: 21rpx;
  color: #6a6a7a;
  font-family: monospace;
}

.sec-line {
  flex: 1;
  height: 1rpx;
  margin-left: 20rpx;
  background: linear-gradient(90deg, rgba(0, 212, 255, 0.3), transparent);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 32rpx;
}

.card {
  width: 48%;
  margin-bottom: 24rpx;
  background-color: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(0, 212, 255, 0.16);
  border-radius: 14rpx;
  overflow: hidden;
}

.card:active {
  background-color: rgba(0, 212, 255, 0.08);
  border-color: rgba(0, 212, 255, 0.45);
}

.card-img-wrap {
  position: relative;
  width: 100%;
  height: 220rpx;
  background-color: #10162a;
}

.card-img {
  width: 100%;
  height: 100%;
  display: block;
}

.card-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 18rpx;
  color: #00d4ff;
  background-color: rgba(0, 212, 255, 0.15);
  border: 1rpx solid rgba(0, 212, 255, 0.4);
  padding: 3rpx 12rpx;
  border-radius: 5rpx;
}

.card-corner {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-color: rgba(0, 212, 255, 0.8);
  border-style: solid;
}

.card-corner.tl { top: 10rpx; left: 10rpx; border-width: 2rpx 0 0 2rpx; }

.card-body {
  padding: 20rpx;
}

.card-name {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #00d4ff;
  margin-bottom: 10rpx;
}

.card-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 21rpx;
  color: #8a8a9a;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.card-action {
  display: block;
  font-size: 20rpx;
  color: #a855f7;
}

/* 详情弹层 */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 200;
  background-color: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.sheet {
  width: 100%;
  max-height: 84vh;
  background: linear-gradient(160deg, #151a30, #0d1020);
  border: 1rpx solid rgba(0, 212, 255, 0.3);
  border-radius: 18rpx;
  overflow: hidden;
}

.sheet-cover {
  width: 100%;
  display: block;
  background-color: #10162a;
}

.sheet-body {
  padding: 32rpx;
}

.sheet-name {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #00d4ff;
  margin-bottom: 16rpx;
}

.sheet-desc {
  display: block;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.8;
}

.sheet-actions {
  display: flex;
  margin-top: 36rpx;
}

.sheet-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  margin-right: 18rpx;
  font-size: 24rpx;
  color: #0a0a14;
  font-weight: bold;
  background: linear-gradient(90deg, #00d4ff, #a855f7);
  border-radius: 10rpx;
}

.sheet-btn:last-child {
  margin-right: 0;
}

.sheet-btn.ghost {
  color: #8a8a9a;
  font-weight: normal;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.sheet-hint {
  display: block;
  font-size: 20rpx;
  color: #5a5a6a;
  text-align: center;
  margin-top: 24rpx;
}
