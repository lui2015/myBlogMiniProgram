.page {
  min-height: 100vh;
  padding: 0 32rpx 80rpx;
}

/* ===== Hero ===== */
.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 -32rpx;
  padding: 56rpx 32rpx 40rpx;
  overflow: hidden;
  background: radial-gradient(ellipse at 50% 0%, #141a33 0%, #0a0a14 78%);
}

.hero-grid {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx);
  background-size: 44rpx 44rpx;
}

.hero-title {
  position: relative;
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  color: #ffffff;
  text-shadow: -4rpx 0 #ff2d95, 4rpx 0 #00d4ff, 0 0 30rpx rgba(0, 212, 255, 0.4);
}

.hero-sub {
  position: relative;
  font-size: 22rpx;
  color: #7a7a96;
  font-family: monospace;
  margin-top: 14rpx;
}

.hero-stats {
  position: relative;
  font-size: 21rpx;
  color: #00d4ff;
  margin-top: 22rpx;
  letter-spacing: 1rpx;
}

.hero-line {
  position: relative;
  width: 140rpx;
  height: 2rpx;
  margin-top: 24rpx;
  background: linear-gradient(90deg, transparent, #00d4ff, transparent);
}

/* ===== 区块头 ===== */
.section-head {
  display: flex;
  align-items: center;
  margin: 40rpx 0 20rpx;
}

.sec-icon {
  font-size: 26rpx;
  color: #00d4ff;
  margin-right: 12rpx;
}

.sec-title {
  font-size: 23rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 3rpx;
  font-family: monospace;
}

.sec-line {
  flex: 1;
  height: 1rpx;
  margin-left: 20rpx;
  background: linear-gradient(90deg, rgba(0, 212, 255, 0.3), transparent);
}

/* ===== 搜索 ===== */
.search-bar {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin-top: 36rpx;
  padding: 0 20rpx;
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(0, 212, 255, 0.2);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.search-icon {
  font-size: 24rpx;
  margin-right: 14rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  font-size: 24rpx;
  color: #ffffff;
}

.search-ph {
  color: #5a5a6a;
}

.search-clear {
  width: 40rpx;
  text-align: center;
  font-size: 32rpx;
  color: #8a8a9a;
}

/* ===== 分类 ===== */
.tabs {
  display: flex;
  width: auto;
  margin: 0 -32rpx;
  padding: 0 32rpx;
}

.tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 140rpx;
  margin-right: 16rpx;
  padding: 20rpx 16rpx;
  background-color: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 12rpx;
}

.tab.active {
  background-color: rgba(0, 212, 255, 0.12);
  border-color: rgba(0, 212, 255, 0.45);
}

.tab-name {
  font-size: 22rpx;
  color: #c8c8d6;
}

.tab.active .tab-name {
  color: #00d4ff;
  font-weight: bold;
}

.tab-count {
  font-size: 18rpx;
  color: #5a5a6a;
  font-family: monospace;
  margin-top: 8rpx;
}

.sub-row,
.sort-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.sub-tab,
.sort {
  padding: 10rpx 20rpx;
  margin: 0 14rpx 12rpx 0;
  font-size: 20rpx;
  color: #8a8a9a;
  background-color: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 24rpx;
}

.sub-tab.active,
.sort.active {
  color: #a855f7;
  background-color: rgba(168, 85, 247, 0.12);
  border-color: rgba(168, 85, 247, 0.4);
}

/* ===== 文章卡片 ===== */
.article-card {
  position: relative;
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.05), rgba(255, 255, 255, 0.015));
  border: 1rpx solid rgba(0, 212, 255, 0.16);
  border-radius: 14rpx;
  overflow: hidden;
}

.article-card:active {
  background-color: rgba(0, 212, 255, 0.1);
  border-color: rgba(0, 212, 255, 0.4);
}

.article-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.article-cat {
  font-size: 19rpx;
  color: #a855f7;
  background-color: rgba(168, 85, 247, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.article-subcat {
  font-size: 19rpx;
  color: #00d4ff;
  margin-right: 12rpx;
}

.article-rec {
  font-size: 18rpx;
  color: #ff2d95;
  border: 1rpx solid rgba(255, 45, 149, 0.35);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.article-fav {
  font-size: 22rpx;
  color: #ff2d95;
  margin-left: auto;
}

.article-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1.5;
}

.article-summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #8a8a9a;
  line-height: 1.65;
}

.article-foot {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.article-date,
.article-views {
  font-size: 19rpx;
  color: #5a5a6a;
  font-family: monospace;
  margin-right: 22rpx;
}

.article-arrow {
  margin-left: auto;
  font-size: 26rpx;
  color: rgba(0, 212, 255, 0.5);
}

.article-corner {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border-color: rgba(0, 212, 255, 0.6);
  border-style: solid;
}

.article-corner.tl { top: 8rpx; left: 8rpx; border-width: 2rpx 0 0 2rpx; }
.article-corner.br { bottom: 8rpx; right: 8rpx; border-width: 0 2rpx 2rpx 0; }

.more-btn {
  margin: 12rpx 0 24rpx;
  padding: 22rpx;
  text-align: center;
  font-size: 23rpx;
  color: #00d4ff;
  background-color: rgba(0, 212, 255, 0.06);
  border: 1rpx solid rgba(0, 212, 255, 0.25);
  border-radius: 10rpx;
}

.more-btn:active {
  background-color: rgba(0, 212, 255, 0.14);
}

/* ===== 说明 ===== */
.tip-card {
  margin-top: 36rpx;
  padding: 26rpx;
  background-color: rgba(168, 85, 247, 0.04);
  border: 1rpx solid rgba(168, 85, 247, 0.15);
  border-left: 4rpx solid #a855f7;
  border-radius: 0 12rpx 12rpx 0;
}

.tip-title {
  display: block;
  font-size: 24rpx;
  color: #a855f7;
  margin-bottom: 12rpx;
}

.tip-text {
  display: block;
  font-size: 21rpx;
  color: #8a8a9a;
  line-height: 1.8;
}

.risk-note {
  margin-top: 24rpx;
  padding: 20rpx;
  font-size: 20rpx;
  color: #ffb4d2;
  line-height: 1.7;
  background-color: rgba(255, 45, 149, 0.05);
  border: 1rpx solid rgba(255, 45, 149, 0.18);
  border-radius: 10rpx;
}
