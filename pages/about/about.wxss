.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 个人资料 */
.profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 40rpx 48rpx;
  background: linear-gradient(180deg, #0f1029, #0a0a14);
}

.avatar-wrap {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  padding: 4rpx;
  background: linear-gradient(135deg, #00d4ff, #a855f7);
  margin-bottom: 24rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  background-color: #15152a;
}

.avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #ffffff;
  font-weight: bold;
}

.profile-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 14rpx;
}

.profile-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  text-align: center;
  line-height: 1.7;
  padding: 0 40rpx;
}

/* 数据概览 */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.stat-card {
  width: 23%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 4rpx;
  background-color: rgba(0, 212, 255, 0.04);
  border: 1rpx solid rgba(0, 212, 255, 0.12);
  border-radius: 12rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #00d4ff;
  font-family: monospace;
  text-shadow: 0 0 12rpx rgba(0, 212, 255, 0.4);
}

.stat-label {
  font-size: 20rpx;
  color: #8a8a9a;
  margin-top: 6rpx;
}

/* 软件作品 */
.soft-list {
  display: flex;
  flex-direction: column;
}

.soft-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background-color: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 14rpx;
}

.soft-card:active {
  background-color: rgba(0, 212, 255, 0.06);
}

.soft-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background-color: #15152a;
  margin-right: 20rpx;
}

.soft-body {
  flex: 1;
  min-width: 0;
}

.soft-name {
  display: block;
  font-size: 27rpx;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.soft-desc {
  display: block;
  font-size: 22rpx;
  color: #8a8a9a;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.soft-hint {
  display: block;
  font-size: 19rpx;
  color: rgba(0, 212, 255, 0.65);
}

/* 技能作品 */
.skill-list {
  background-color: rgba(255, 255, 255, 0.02);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 14rpx;
  overflow: hidden;
}

.skill-row {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.skill-row:last-child {
  border-bottom: none;
}

.skill-row:active {
  background-color: rgba(0, 212, 255, 0.05);
}

.skill-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #00d4ff;
  box-shadow: 0 0 8rpx #00d4ff;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.skill-content {
  flex: 1;
  min-width: 0;
}

.skill-name {
  display: block;
  font-size: 25rpx;
  color: #ffffff;
  margin-bottom: 4rpx;
}

.skill-desc {
  display: block;
  font-size: 21rpx;
  color: #8a8a9a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.skill-arrow {
  font-size: 26rpx;
  color: rgba(0, 212, 255, 0.45);
  margin-left: 12rpx;
}

/* 自媒体 */
.social-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.social-card {
  width: 31%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 8rpx;
  margin-bottom: 20rpx;
  background-color: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-top: 3rpx solid #00d4ff;
  border-radius: 10rpx;
}

.social-card:active {
  background-color: rgba(0, 212, 255, 0.08);
}

.social-icon {
  font-size: 36rpx;
  margin-bottom: 10rpx;
}

.social-name {
  font-size: 23rpx;
  color: #ffffff;
  margin-bottom: 6rpx;
}

.social-desc {
  font-size: 18rpx;
  color: #8a8a9a;
  text-align: center;
}

.social-hint {
  display: block;
  font-size: 20rpx;
  color: #6a6a7a;
  text-align: center;
  margin-top: 4rpx;
}

/* 博客链接 */
.blog-link {
  background-color: rgba(0, 212, 255, 0.05);
  border: 1rpx solid rgba(0, 212, 255, 0.22);
  border-radius: 12rpx;
  padding: 30rpx;
  text-align: center;
}

.link-text {
  display: block;
  font-size: 27rpx;
  color: #00d4ff;
  margin-bottom: 10rpx;
}

.link-hint {
  display: block;
  font-size: 21rpx;
  color: #8a8a9a;
}

.footer {
  padding: 40rpx;
  text-align: center;
}

.footer-text {
  font-size: 20rpx;
  color: #5a5a6a;
}
