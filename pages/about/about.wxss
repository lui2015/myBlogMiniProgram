.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  background-color: #0a0a14;
}

/* ===== ABOUT ME 标题 ===== */
.hero {
  position: relative;
  padding: 72rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  background: radial-gradient(ellipse at 50% 0%, #141a33 0%, #0a0a14 75%);
}

.hero-grid {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx);
  background-size: 44rpx 44rpx;
}

.hero-title {
  position: relative;
  font-size: 76rpx;
  font-weight: 900;
  letter-spacing: 10rpx;
  color: #ffffff;
  text-shadow: -5rpx 0 #ff2d95, 5rpx 0 #00d4ff, 0 0 36rpx rgba(0, 212, 255, 0.45);
}

.hero-sub {
  position: relative;
  font-size: 22rpx;
  color: #7a7a96;
  font-family: monospace;
  margin-top: 18rpx;
  letter-spacing: 2rpx;
}

.hero-line {
  position: relative;
  width: 160rpx;
  height: 2rpx;
  margin-top: 30rpx;
  background: linear-gradient(90deg, transparent, #00d4ff, transparent);
}

/* ===== 个人资料卡片 ===== */
.profile-card {
  display: flex;
  margin: 0 32rpx;
  padding: 36rpx 30rpx;
  background: linear-gradient(135deg, rgba(16, 24, 48, 0.95), rgba(10, 14, 30, 0.9));
  border: 1rpx solid rgba(0, 212, 255, 0.28);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.35);
}

.avatar-box {
  width: 176rpx;
  height: 196rpx;
  padding: 4rpx;
  flex-shrink: 0;
  margin-right: 28rpx;
  background: linear-gradient(135deg, #00d4ff, #a855f7);
  box-sizing: border-box;
  border-radius: 12rpx;
  clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
}

.avatar-hex {
  width: 100%;
  height: 100%;
  display: block;
  background-color: #1a2340;
  clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
}

.avatar-hex--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #ffffff;
  font-weight: bold;
}

.profile-body {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #00d4ff;
  margin-bottom: 8rpx;
}

.profile-role {
  display: block;
  font-size: 22rpx;
  color: #a855f7;
  margin-bottom: 16rpx;
}

.profile-bio {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.75;
}

.social-row {
  display: flex;
  margin-top: 20rpx;
}

.social-btn {
  width: 60rpx;
  height: 60rpx;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 212, 255, 0.05);
  border: 1rpx solid rgba(0, 212, 255, 0.28);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #00d4ff;
}

.social-btn:active {
  background-color: rgba(0, 212, 255, 0.18);
}

/* ===== 区块标题 ===== */
.tree-head {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.tree-icon {
  font-size: 26rpx;
  color: #a855f7;
  margin-right: 12rpx;
}

.tree-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #a855f7;
  letter-spacing: 4rpx;
  font-family: monospace;
}

.tree-line {
  width: 90rpx;
  height: 1rpx;
  margin: 0 20rpx;
  background: linear-gradient(90deg, transparent, rgba(168, 85, 247, 0.45), transparent);
}

/* ===== SKILL TREE ===== */
.skill-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.skill-chip {
  width: 23.5%;
  height: 88rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(0, 212, 255, 0.06), rgba(10, 16, 32, 0.5));
  border: 1rpx solid rgba(0, 212, 255, 0.22);
  border-top: 2rpx solid rgba(0, 212, 255, 0.55);
  border-radius: 8rpx;
}

.skill-chip text {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.75);
  text-align: center;
}

/* ===== TIMELINE ===== */
.timeline {
  padding-left: 8rpx;
}

.tl-item {
  position: relative;
  padding-left: 48rpx;
  padding-bottom: 40rpx;
}

.tl-item::before {
  content: '';
  position: absolute;
  left: 15rpx;
  top: 18rpx;
  bottom: -14rpx;
  width: 2rpx;
  background: linear-gradient(180deg, rgba(0, 212, 255, 0.45), rgba(168, 85, 247, 0.15));
}

.tl-item:last-child::before {
  display: none;
}

.tl-dot {
  position: absolute;
  left: 6rpx;
  top: 10rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #a855f7;
  box-shadow: 0 0 12rpx rgba(168, 85, 247, 0.8);
}

.tl-content {
  display: flex;
  flex-direction: column;
}

.tl-year {
  font-size: 21rpx;
  color: #00d4ff;
  font-family: monospace;
  margin-bottom: 6rpx;
}

.tl-title {
  font-size: 27rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.tl-desc {
  font-size: 22rpx;
  color: #8a8a9a;
  line-height: 1.6;
}

/* ===== 加载 / 离线提示 ===== */
.state {
  padding: 100rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.state-text {
  font-size: 24rpx;
  color: #7a7a96;
}

.offline-tip {
  margin: 0 32rpx 24rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(255, 173, 64, 0.45);
  border-radius: 10rpx;
  background-color: rgba(255, 173, 64, 0.08);
}

.offline-text {
  font-size: 21rpx;
  color: #ffc069;
}

/* ===== 底部 ===== */
.footer {
  padding: 20rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-line {
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.45), transparent);
  margin-bottom: 20rpx;
}

.footer-text {
  font-size: 20rpx;
  color: #5a5a6a;
}

.footer-refresh {
  margin-top: 16rpx;
  padding: 10rpx 28rpx;
  font-size: 21rpx;
  color: #00d4ff;
  border: 1rpx solid rgba(0, 212, 255, 0.4);
  border-radius: 30rpx;
}

.footer-refresh:active {
  background-color: rgba(0, 212, 255, 0.1);
}
