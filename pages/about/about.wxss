.container {
  padding: 32rpx;
  background-color: #0f0f1a;
  min-height: 100vh;
}

.profile-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.avatar-wrapper {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #00d4ff, #a855f7);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.avatar-text {
  font-size: 56rpx;
  color: #ffffff;
  font-weight: bold;
}

.name {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.role {
  font-size: 26rpx;
  color: #00d4ff;
  margin-bottom: 20rpx;
}

.desc {
  font-size: 26rpx;
  color: #8a8a9a;
  text-align: center;
  line-height: 1.6;
  padding: 0 20rpx;
}

.section {
  margin-top: 48rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 24rpx;
}

.skills {
  display: flex;
  flex-wrap: wrap;
}

.skill-item {
  font-size: 24rpx;
  color: #00d4ff;
  background-color: rgba(0, 212, 255, 0.1);
  border: 1rpx solid rgba(0, 212, 255, 0.3);
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.timeline {
  padding-left: 20rpx;
}

.timeline-item {
  display: flex;
  padding-bottom: 32rpx;
  position: relative;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background-color: rgba(0, 212, 255, 0.3);
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #00d4ff;
  margin-right: 24rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
}

.timeline-content {
  flex: 1;
}

.timeline-year {
  display: block;
  font-size: 24rpx;
  color: #a855f7;
  margin-bottom: 4rpx;
}

.timeline-milestone {
  display: block;
  font-size: 28rpx;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.timeline-desc {
  display: block;
  font-size: 24rpx;
  color: #8a8a9a;
}

.contact-list {
  background-color: rgba(255, 255, 255, 0.03);
  border-radius: 12rpx;
  padding: 8rpx 24rpx;
}

.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-name {
  font-size: 26rpx;
  color: #ffffff;
}

.contact-value {
  font-size: 24rpx;
  color: #8a8a9a;
}

.blog-link {
  background-color: rgba(0, 212, 255, 0.05);
  border: 1rpx solid rgba(0, 212, 255, 0.2);
  border-radius: 12rpx;
  padding: 28rpx;
  text-align: center;
}

.link-text {
  display: block;
  font-size: 28rpx;
  color: #00d4ff;
  margin-bottom: 8rpx;
}

.link-hint {
  display: block;
  font-size: 22rpx;
  color: #8a8a9a;
}
