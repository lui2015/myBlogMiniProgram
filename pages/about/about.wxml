<view class="page">

  <!-- ABOUT ME -->
  <view class="hero">
    <view class="hero-grid"></view>
    <text class="hero-title">{{pageTitle}}</text>
    <text class="hero-sub">{{pageSubtitle}}</text>
    <view class="hero-line"></view>
  </view>

  <view wx:if="{{loading}}" class="state">
    <text class="state-text">正在加载…</text>
  </view>

  <view wx:elif="{{empty}}" class="state">
    <text class="state-text">无法读取「关于我」数据：{{error}}</text>
    <view class="state-retry" bindtap="onRetry">重新加载</view>
  </view>

  <block wx:else>
    <view wx:if="{{offline}}" class="offline-tip" bindtap="onRetry">
      <text class="offline-text">{{error}} · 显示上次同步内容，点击重试</text>
    </view>

    <!-- 个人资料卡片 -->
    <view class="profile-card">
      <view class="avatar-box">
        <image wx:if="{{avatarUrl}}" class="avatar-hex" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
        <view wx:else class="avatar-hex avatar-hex--text"><text>{{avatarText}}</text></view>
      </view>
      <view class="profile-body">
        <text class="profile-name">{{name}}</text>
        <text wx:if="{{role}}" class="profile-role">{{role}}</text>
        <text wx:if="{{bio}}" class="profile-bio">{{bio}}</text>
        <view class="social-row">
          <view
            class="social-btn"
            wx:for="{{socials}}"
            wx:key="key"
            bindtap="onSocialTap"
            data-value="{{item.value}}"
            data-label="{{item.label}}"
          ><text>{{item.icon}}</text></view>
        </view>
      </view>
    </view>

    <!-- SKILL TREE -->
    <view wx:if="{{skillTree.length}}" class="cy-section">
      <view class="tree-head">
        <view class="tree-line"></view>
        <text class="tree-icon">✦</text>
        <text class="tree-title">SKILL TREE</text>
        <view class="tree-line"></view>
      </view>
      <view class="skill-grid">
        <view class="skill-chip" wx:for="{{skillTree}}" wx:key="*this">
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <!-- TIMELINE -->
    <view wx:if="{{timeline.length}}" class="cy-section">
      <view class="tree-head">
        <view class="tree-line"></view>
        <text class="tree-icon">✦</text>
        <text class="tree-title">TIMELINE</text>
        <view class="tree-line"></view>
      </view>
      <view class="timeline">
        <view class="tl-item" wx:for="{{timeline}}" wx:key="id">
          <view class="tl-dot"></view>
          <view class="tl-content">
            <text class="tl-year">{{item.year}}</text>
            <text class="tl-title">{{item.title}}</text>
            <text class="tl-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="footer">
      <view class="footer-line"></view>
      <text class="footer-text">{{syncText}}</text>
      <view class="footer-refresh" bindtap="onRetry">↻ 刷新数据</view>
    </view>
  </block>

</view>
