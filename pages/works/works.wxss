.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 60rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(0, 212, 255, 0.18);
  border-radius: 38rpx;
}

.search-icon {
  font-size: 34rpx;
  color: #00d4ff;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #ffffff;
  height: 76rpx;
}

.search-ph {
  color: #6a6a7a;
}

.search-clear {
  font-size: 26rpx;
  color: #8a8a9a;
  padding: 0 8rpx;
}

.cat-scroll {
  margin-top: 28rpx;
  white-space: nowrap;
}

.cat-list {
  display: inline-flex;
}

.cat-item {
  font-size: 24rpx;
  color: #8a8a9a;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  margin-right: 16rpx;
  background-color: rgba(255, 255, 255, 0.05);
  flex-shrink: 0;
}

.cat-item.active {
  color: #00d4ff;
  background-color: rgba(0, 212, 255, 0.15);
  border: 1rpx solid rgba(0, 212, 255, 0.35);
}

.result-count {
  font-size: 21rpx;
  color: #6a6a7a;
  font-family: monospace;
  margin: 28rpx 0 16rpx;
}

.list {
  display: flex;
  flex-direction: column;
}

.work-card {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
  background-color: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  overflow: hidden;
}

.work-card:active {
  background-color: rgba(0, 212, 255, 0.06);
}

.work-cover {
  width: 100%;
  height: 260rpx;
  display: block;
  background-color: #15152a;
}

.work-body {
  padding: 24rpx;
}

.work-meta {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.work-date {
  font-size: 20rpx;
  color: #6a6a7a;
}

.work-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1.4;
  margin-bottom: 10rpx;
}

.work-excerpt {
  display: block;
  font-size: 24rpx;
  color: #8a8a9a;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.work-foot {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.work-tag {
  font-size: 20rpx;
  color: rgba(0, 212, 255, 0.7);
  margin-right: 12rpx;
}

.work-readtime {
  font-size: 20rpx;
  color: #6a6a7a;
  margin-left: auto;
}
