.page {
  min-height: 100vh;
  padding: 0 32rpx 80rpx;
}

/* ===== Hero ===== */
.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 -32rpx;
  padding: 56rpx 32rpx 40rpx;
  overflow: hidden;
  background: radial-gradient(ellipse at 50% 0%, #141a33 0%, #0a0a14 78%);
}

.hero-grid {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx);
  background-size: 44rpx 44rpx;
}

.hero-title {
  position: relative;
  font-size: 46rpx;
  font-weight: 900;
  letter-spacing: 5rpx;
  color: #ffffff;
  text-shadow: -4rpx 0 #ff2d95, 4rpx 0 #00d4ff, 0 0 30rpx rgba(0, 212, 255, 0.4);
}

.hero-sub {
  position: relative;
  font-size: 22rpx;
  color: #7a7a96;
  font-family: monospace;
  margin-top: 14rpx;
}

.hero-stats {
  position: relative;
  font-size: 21rpx;
  color: #00d4ff;
  margin-top: 22rpx;
  letter-spacing: 1rpx;
}

.hero-line {
  position: relative;
  width: 140rpx;
  height: 2rpx;
  margin-top: 24rpx;
  background: linear-gradient(90deg, transparent, #00d4ff, transparent);
}

/* ===== 区块头 ===== */
.section-head {
  display: flex;
  align-items: center;
  margin: 40rpx 0 22rpx;
}

.sec-icon {
  font-size: 26rpx;
  color: #00d4ff;
  margin-right: 12rpx;
}

.sec-title {
  font-size: 23rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 3rpx;
  font-family: monospace;
}

.sec-line {
  flex: 1;
  height: 1rpx;
  margin-left: 20rpx;
  background: linear-gradient(90deg, rgba(0, 212, 255, 0.3), transparent);
}

/* ===== 每日一模型 ===== */
.daily-card {
  position: relative;
  padding: 28rpx;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(168, 85, 247, 0.16), rgba(0, 212, 255, 0.06));
  border: 1rpx solid rgba(168, 85, 247, 0.35);
  border-radius: 16rpx;
}

.daily-card:active {
  background: linear-gradient(135deg, rgba(168, 85, 247, 0.24), rgba(0, 212, 255, 0.1));
}

.daily-card-grid {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.02) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1rpx, transparent 1rpx);
  background-size: 36rpx 36rpx;
}

.daily-top,
.daily-main,
.daily-quote,
.daily-more {
  position: relative;
}

.daily-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.daily-label {
  font-size: 21rpx;
  color: #c9a2ff;
  letter-spacing: 1rpx;
}

.daily-shuffle {
  font-size: 20rpx;
  color: #00d4ff;
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.35);
  border-radius: 24rpx;
}

.daily-shuffle:active {
  background-color: rgba(0, 212, 255, 0.12);
}

.daily-main {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
}

.daily-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 46rpx;
  flex-shrink: 0;
  margin-right: 22rpx;
  background-color: rgba(168, 85, 247, 0.14);
  border: 1rpx solid rgba(168, 85, 247, 0.3);
  border-radius: 14rpx;
}

.daily-body {
  flex: 1;
  min-width: 0;
}

.daily-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.daily-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
  margin-right: 14rpx;
}

.daily-stars {
  font-size: 18rpx;
}

.daily-cat {
  display: block;
  font-size: 21rpx;
  color: #a8a8bc;
  margin-top: 10rpx;
  line-height: 1.6;
}

.daily-quote {
  display: block;
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  font-size: 23rpx;
  color: #ffffff;
  line-height: 1.7;
  background-color: rgba(255, 255, 255, 0.05);
  border-left: 3rpx solid #a855f7;
  border-radius: 0 8rpx 8rpx 0;
}

.daily-more {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 22rpx;
  font-size: 21rpx;
  color: #00d4ff;
}

.daily-arrow {
  margin-left: 8rpx;
}

.daily-corner {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-color: rgba(168, 85, 247, 0.8);
  border-style: solid;
}

.daily-corner.tl { top: 8rpx; left: 8rpx; border-width: 2rpx 0 0 2rpx; }
.daily-corner.br { bottom: 8rpx; right: 8rpx; border-width: 0 2rpx 2rpx 0; }

/* ===== 搜索 ===== */
.search-bar {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin-top: 36rpx;
  padding: 0 20rpx;
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(0, 212, 255, 0.2);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.search-icon {
  font-size: 24rpx;
  margin-right: 14rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  font-size: 24rpx;
  color: #ffffff;
}

.search-ph {
  color: #5a5a6a;
}

.search-clear {
  width: 40rpx;
  text-align: center;
  font-size: 32rpx;
  color: #8a8a9a;
}

/* ===== 分类 / 难度 ===== */
.tabs {
  display: flex;
  width: auto;
  margin: 0 -32rpx;
  padding: 0 32rpx;
}

.tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  min-width: 132rpx;
  margin-right: 16rpx;
  padding: 20rpx 12rpx;
  background-color: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 12rpx;
}

.tab.active {
  background-color: rgba(0, 212, 255, 0.12);
  border-color: rgba(0, 212, 255, 0.45);
}

.tab-icon {
  font-size: 34rpx;
  line-height: 1.3;
}

.tab-name {
  font-size: 21rpx;
  color: #c8c8d6;
  margin-top: 10rpx;
}

.tab.active .tab-name {
  color: #00d4ff;
  font-weight: bold;
}

.tab-count {
  font-size: 18rpx;
  color: #5a5a6a;
  font-family: monospace;
  margin-top: 6rpx;
}

.diff-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.diff {
  padding: 10rpx 20rpx;
  margin: 0 14rpx 12rpx 0;
  font-size: 20rpx;
  color: #8a8a9a;
  background-color: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 24rpx;
}

.diff.active {
  color: #a855f7;
  background-color: rgba(168, 85, 247, 0.12);
  border-color: rgba(168, 85, 247, 0.4);
}

/* ===== 模型列表 ===== */
.model-card {
  position: relative;
  display: flex;
  align-items: flex-start;
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.05), rgba(255, 255, 255, 0.015));
  border: 1rpx solid rgba(0, 212, 255, 0.16);
  border-radius: 14rpx;
  overflow: hidden;
}

.model-card:active {
  background-color: rgba(0, 212, 255, 0.1);
  border-color: rgba(0, 212, 255, 0.4);
}

.model-icon-wrap {
  width: 78rpx;
  height: 78rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 212, 255, 0.08);
  border: 1rpx solid rgba(0, 212, 255, 0.25);
  border-radius: 12rpx;
}

.model-icon {
  font-size: 40rpx;
}

.model-body {
  flex: 1;
  min-width: 0;
}

.model-top {
  display: flex;
  align-items: center;
}

.model-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  margin-right: 12rpx;
}

.model-fav {
  font-size: 22rpx;
  color: #ff2d95;
}

.model-sub {
  display: block;
  font-size: 21rpx;
  color: #8a8a9a;
  line-height: 1.6;
  margin-top: 8rpx;
}

.model-quote {
  display: block;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.68);
  line-height: 1.6;
  margin-top: 12rpx;
}

.model-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.model-cat {
  font-size: 19rpx;
  color: #a855f7;
  background-color: rgba(168, 85, 247, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.model-stars {
  font-size: 17rpx;
}

.model-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.model-tag {
  font-size: 18rpx;
  color: #7a7a96;
  margin-right: 14rpx;
}

.model-arrow {
  font-size: 28rpx;
  color: rgba(0, 212, 255, 0.5);
  margin-left: 10rpx;
  align-self: center;
}

.model-corner {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border-color: rgba(0, 212, 255, 0.6);
  border-style: solid;
}

.model-corner.tl { top: 8rpx; left: 8rpx; border-width: 2rpx 0 0 2rpx; }
.model-corner.br { bottom: 8rpx; right: 8rpx; border-width: 0 2rpx 2rpx 0; }

.more-btn {
  margin: 12rpx 0 24rpx;
  padding: 22rpx;
  text-align: center;
  font-size: 23rpx;
  color: #00d4ff;
  background-color: rgba(0, 212, 255, 0.06);
  border: 1rpx solid rgba(0, 212, 255, 0.25);
  border-radius: 10rpx;
}

.more-btn:active {
  background-color: rgba(0, 212, 255, 0.14);
}

/* ===== 说明 ===== */
.tip-card {
  margin-top: 36rpx;
  padding: 26rpx;
  background-color: rgba(168, 85, 247, 0.04);
  border: 1rpx solid rgba(168, 85, 247, 0.15);
  border-left: 4rpx solid #a855f7;
  border-radius: 0 12rpx 12rpx 0;
}

.tip-title {
  display: block;
  font-size: 24rpx;
  color: #a855f7;
  margin-bottom: 12rpx;
}

.tip-text {
  display: block;
  font-size: 21rpx;
  color: #8a8a9a;
  line-height: 1.8;
}
