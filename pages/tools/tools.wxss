.page {
  min-height: 100vh;
  padding: 0 32rpx 80rpx;
}

.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 -32rpx;
  padding: 60rpx 32rpx 44rpx;
  overflow: hidden;
  background: radial-gradient(ellipse at 50% 0%, #141a33 0%, #0a0a14 78%);
}

.hero-grid {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx);
  background-size: 44rpx 44rpx;
}

.hero-title {
  position: relative;
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  color: #ffffff;
  text-shadow: -4rpx 0 #ff2d95, 4rpx 0 #00d4ff, 0 0 30rpx rgba(0, 212, 255, 0.4);
}

.hero-sub {
  position: relative;
  font-size: 22rpx;
  color: #7a7a96;
  font-family: monospace;
  margin-top: 16rpx;
}

.hero-line {
  position: relative;
  width: 140rpx;
  height: 2rpx;
  margin-top: 26rpx;
  background: linear-gradient(90deg, transparent, #00d4ff, transparent);
}

.section-head {
  display: flex;
  align-items: center;
  margin: 44rpx 0 24rpx;
}

.sec-icon {
  font-size: 26rpx;
  color: #00d4ff;
  margin-right: 12rpx;
}

.sec-title {
  font-size: 23rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 3rpx;
  font-family: monospace;
}

.sec-line {
  flex: 1;
  height: 1rpx;
  margin-left: 20rpx;
  background: linear-gradient(90deg, rgba(0, 212, 255, 0.3), transparent);
}

/* ===== 分类分组与配色 ===== */
.tone-cyan {
  --tone: #00d4ff;
  --tone-bg: rgba(0, 212, 255, 0.08);
  --tone-line: rgba(0, 212, 255, 0.25);
}

.tone-pink {
  --tone: #ff2d95;
  --tone-bg: rgba(255, 45, 149, 0.08);
  --tone-line: rgba(255, 45, 149, 0.25);
}

.tone-purple {
  --tone: #a855f7;
  --tone-bg: rgba(168, 85, 247, 0.08);
  --tone-line: rgba(168, 85, 247, 0.25);
}

.tone-amber {
  --tone: #ffc857;
  --tone-bg: rgba(255, 200, 87, 0.08);
  --tone-line: rgba(255, 200, 87, 0.25);
}

.tone-green {
  --tone: #3ddc97;
  --tone-bg: rgba(61, 220, 151, 0.08);
  --tone-line: rgba(61, 220, 151, 0.25);
}

.tone-slate {
  --tone: #9aa8c7;
  --tone-bg: rgba(154, 168, 199, 0.08);
  --tone-line: rgba(154, 168, 199, 0.25);
}

/* ===== 折叠分类卡片 ===== */
.group {
  margin-bottom: 20rpx;
  border: 1rpx solid var(--tone-line);
  border-radius: 16rpx;
  background: linear-gradient(135deg, var(--tone-bg), rgba(255, 255, 255, 0.03));
  overflow: hidden;
}

.group.open {
  border-color: var(--tone);
  background: linear-gradient(135deg, var(--tone-bg), rgba(255, 255, 255, 0.045));
  box-shadow: 0 0 24rpx rgba(0, 0, 0, 0.25);
}

.group-head {
  display: flex;
  align-items: center;
  padding: 22rpx;
  border-left: 6rpx solid var(--tone);
}

.group-head-hover {
  background-color: var(--tone-bg);
}

.group-mark {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--tone-line);
  border-radius: 14rpx;
  background-color: var(--tone-bg);
}

.group-no {
  font-size: 24rpx;
  font-weight: bold;
  font-family: monospace;
  color: #00d4ff;
  color: var(--tone);
}

.group-title {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.group-label {
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
  font-family: monospace;
  color: #00d4ff;
  color: var(--tone);
}

.group-name {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #7a7a96;
}

.group-side {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.group-count {
  margin-right: 16rpx;
  font-size: 19rpx;
  font-family: monospace;
  color: #8a8a9a;
}

.group-toggle {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  font-family: monospace;
  color: #00d4ff;
  color: var(--tone);
  background-color: var(--tone-bg);
  border: 1rpx solid var(--tone-line);
  border-radius: 12rpx;
}

.group.open .group-toggle {
  color: #0a0a14;
  background-color: var(--tone);
  border-color: var(--tone);
}

.sec-hint {
  margin-left: 16rpx;
  padding: 6rpx 14rpx;
  font-size: 18rpx;
  color: #8a8a9a;
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
}

@keyframes foldIn {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.group-body {
  padding: 0 22rpx 8rpx;
  border-top: 1rpx solid var(--tone-line);
  animation: foldIn 0.2s ease;
}

.group-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0 32rpx;
}

.group-empty-icon {
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #00d4ff;
  color: var(--tone);
}

.group-empty-text {
  font-size: 21rpx;
  color: #7a7a96;
}

/* 展开后是卡片内的行，不再套一层边框卡片 */
.tool-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.tool-row:last-child {
  border-bottom: none;
}

.tool-row-hover {
  opacity: 0.65;
}

.tool-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 212, 255, 0.08);
  background-color: var(--tone-bg);
  border: 1rpx solid rgba(0, 212, 255, 0.25);
  border: 1rpx solid var(--tone-line);
  border-radius: 14rpx;
}

.tool-icon {
  font-size: 38rpx;
}

.tool-body {
  flex: 1;
  min-width: 0;
}

.tool-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.tool-name {
  font-size: 27rpx;
  font-weight: bold;
  color: #ffffff;
  margin-right: 12rpx;
}

.tool-tag {
  font-size: 18rpx;
  color: #a855f7;
  background-color: rgba(168, 85, 247, 0.12);
  padding: 3rpx 10rpx;
  border-radius: 4rpx;
}

.tool-desc {
  display: block;
  font-size: 21rpx;
  color: #8a8a9a;
  line-height: 1.6;
}

.tool-preview {
  display: block;
  margin-top: 10rpx;
  padding-left: 12rpx;
  border-left: 2rpx solid var(--tone);
  font-size: 19rpx;
  color: #00d4ff;
  color: var(--tone);
  font-family: monospace;
  line-height: 1.5;
}

.tool-arrow {
  font-size: 28rpx;
  color: #00d4ff;
  color: var(--tone);
  opacity: 0.6;
  margin-left: 12rpx;
}

.coming {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 60rpx;
}

.coming-line {
  width: 70rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.3), transparent);
  margin: 0 20rpx;
}

.coming-text {
  font-size: 19rpx;
  color: #5a5a6a;
  font-family: monospace;
  letter-spacing: 2rpx;
}
