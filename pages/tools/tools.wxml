<view class="page">

  <view class="hero">
    <view class="hero-grid"></view>
    <text class="hero-title">UTILITY TOOLS</text>
    <text class="hero-sub">// 实用小工具集合</text>
    <view class="hero-line"></view>
  </view>

  <view class="section-head">
    <text class="sec-icon">◈</text>
    <text class="sec-title">{{toolTitle}} · {{sections.length}} GROUPS</text>
    <view class="sec-line"></view>
    <text class="sec-hint">{{toolsHint || '点击分类展开 ▾'}}</text>
  </view>

  <view wx:if="{{!sections.length}}" class="group-empty">
    <text class="group-empty-icon">✦</text>
    <text class="group-empty-text">后台暂未开放任何工具，敬请期待</text>
  </view>

  <view class="group {{section.open ? 'open' : ''}} tone-{{section.tone}}" wx:for="{{sections}}" wx:for-item="section" wx:for-index="gi" wx:key="key">
    <view class="group-head" bindtap="toggleGroup" data-key="{{section.key}}" hover-class="group-head-hover" hover-stay-time="80">
      <view class="group-mark">
        <text class="group-no">{{section.no}}</text>
      </view>
      <view class="group-title">
        <text class="group-label">{{section.label}}</text>
        <text class="group-name">{{section.name}}</text>
      </view>
      <view class="group-side">
        <text class="group-count">{{section.countText}}</text>
        <text class="group-toggle">{{section.open ? '−' : '+'}}</text>
      </view>
    </view>

    <view wx:if="{{section.open}}" class="group-body">
      <view class="tool-row" wx:for="{{section.tools}}" wx:key="key" bindtap="goTool" data-path="{{item.path}}" hover-class="tool-row-hover" hover-stay-time="80">
        <view class="tool-icon-wrap">
          <text class="tool-icon">{{item.icon}}</text>
        </view>
        <view class="tool-body">
          <view class="tool-top">
            <text class="tool-name">{{item.name}}</text>
            <text class="tool-tag">{{item.tag}}</text>
          </view>
          <text class="tool-desc">{{item.desc}}</text>
          <text wx:if="{{item.preview}}" class="tool-preview">{{item.preview}}</text>
        </view>
        <text class="tool-arrow">→</text>
      </view>
      <view wx:if="{{!section.tools.length}}" class="group-empty">
        <text class="group-empty-icon">✦</text>
        <text class="group-empty-text">这个分类的工具还在准备中，敬请期待</text>
      </view>
    </view>
  </view>

  <view class="coming">
    <view class="coming-line"></view>
    <text class="coming-text">NATIVE FEATURES · 持续添加中</text>
    <view class="coming-line"></view>
  </view>

</view>
