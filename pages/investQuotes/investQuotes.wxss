page {
  background: #0a0a14;
}

.page {
  min-height: 100vh;
  padding: 0 30rpx 60rpx;
  box-sizing: border-box;
  color: #ffffff;
  background:
    radial-gradient(circle at 88% -8%, rgba(255, 200, 87, 0.15), transparent 46%),
    radial-gradient(circle at 4% 20%, rgba(0, 212, 255, 0.06), transparent 44%),
    #0a0a14;
}

/* Hero */
.hero {
  padding: 54rpx 8rpx 30rpx;
}

.hero-kicker {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #ffc857;
  font-family: monospace;
}

.hero-title {
  display: block;
  margin-top: 14rpx;
  font-size: 62rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.hero-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8d95ad;
  font-family: monospace;
}

.offline-tip {
  margin-bottom: 20rpx;
  padding: 14rpx 20rpx;
  border: 1rpx solid rgba(255, 200, 87, 0.28);
  border-radius: 12rpx;
  background: rgba(255, 200, 87, 0.07);
  font-size: 21rpx;
  color: #ffc857;
}

/* 每日一句 */
.daily-card {
  position: relative;
  padding: 30rpx 28rpx 24rpx;
  border: 1rpx solid rgba(255, 200, 87, 0.3);
  border-radius: 20rpx;
  background: linear-gradient(150deg, rgba(255, 200, 87, 0.12), rgba(255, 255, 255, 0.025) 60%);
  overflow: hidden;
}

.daily-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.daily-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 200, 87, 0.16);
  font-size: 20rpx;
  color: #ffc857;
}

.daily-count {
  font-size: 20rpx;
  color: #8d95ad;
  font-family: monospace;
}

.daily-mark {
  display: block;
  height: 56rpx;
  font-size: 84rpx;
  line-height: 1;
  color: rgba(255, 200, 87, 0.5);
  font-family: serif;
}

.daily-cn {
  display: block;
  font-size: 32rpx;
  line-height: 1.65;
  color: #fff8e8;
}

.daily-en {
  margin-top: 18rpx;
  padding-left: 18rpx;
  border-left: 2rpx solid rgba(255, 200, 87, 0.35);
}

.daily-en text {
  font-size: 22rpx;
  line-height: 1.6;
  color: #a9b3c9;
}

.daily-meta {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
}

.daily-master {
  font-size: 24rpx;
  color: #ffc857;
}

.daily-source {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #7e879d;
}

.daily-tags,
.quote-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.daily-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.act {
  flex: 1;
  padding: 16rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.04);
  text-align: center;
  font-size: 22rpx;
  color: #d8dfeb;
}

.act-on {
  border-color: rgba(255, 200, 87, 0.5);
  background: rgba(255, 200, 87, 0.14);
  color: #ffc857;
}

/* 视图切换 */
.view-tabs {
  display: flex;
  gap: 14rpx;
  margin-top: 34rpx;
}

.view-tab {
  flex: 1;
  padding: 20rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.03);
  text-align: center;
  font-size: 24rpx;
  color: #8d95ad;
}

.view-tab.active {
  border-color: rgba(255, 200, 87, 0.5);
  background: rgba(255, 200, 87, 0.13);
  color: #ffc857;
}

/* 搜索与筛选 */
.search-bar {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 200, 87, 0.2);
  border-radius: 38rpx;
}

.search-icon {
  font-size: 34rpx;
  color: #ffc857;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #ffffff;
  height: 76rpx;
}

.search-ph {
  color: #6a6a7a;
}

.search-clear {
  font-size: 26rpx;
  color: #8a8a9a;
  padding: 0 8rpx;
}

.filter-block {
  margin-top: 22rpx;
}

.filter-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #8d95ad;
  font-family: monospace;
}

.chip-scroll {
  white-space: nowrap;
}

.chip-row {
  display: inline-flex;
  align-items: center;
}

.chip {
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.04);
  font-size: 21rpx;
  color: #9aa4b8;
}

.chip-on {
  border-color: rgba(255, 200, 87, 0.5);
  background: rgba(255, 200, 87, 0.14);
  color: #ffc857;
}

.chip-static {
  padding: 6rpx 14rpx;
  margin-right: 10rpx;
  font-size: 19rpx;
  color: #8fb6c8;
  background: rgba(0, 212, 255, 0.08);
  border-color: rgba(0, 212, 255, 0.18);
}

.state-hint {
  display: block;
  margin-top: 14rpx;
  padding: 0 30rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #6a6a7a;
}

.result-count {
  margin: 26rpx 0 16rpx;
  font-size: 21rpx;
  color: #6a6a7a;
  font-family: monospace;
}

/* 名言列表 */
.quote-list {
  display: flex;
  flex-direction: column;
}

.quote-card {
  margin-bottom: 22rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.028);
}

.quote-card:active {
  background: rgba(255, 200, 87, 0.06);
}

.quote-head {
  display: flex;
  align-items: center;
}

.quote-no {
  width: 44rpx;
  font-size: 20rpx;
  color: #6a6a7a;
  font-family: monospace;
}

.quote-master {
  flex: 1;
  font-size: 23rpx;
  color: #ffc857;
}

.quote-fav {
  padding: 0 8rpx;
  font-size: 34rpx;
  color: #6a6a7a;
}

.quote-fav.on {
  color: #ffc857;
}

.quote-cn {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #f2f5fb;
}

.quote-extra {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.quote-en {
  display: block;
  font-size: 22rpx;
  line-height: 1.65;
  color: #a9b3c9;
}

.quote-source {
  display: block;
  margin-top: 14rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #7e879d;
}

.quote-copy {
  margin-top: 18rpx;
  padding: 14rpx 0;
  border: 1rpx solid rgba(255, 200, 87, 0.35);
  border-radius: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #ffc857;
}

.quote-foot {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.quote-tag-line {
  flex: 1;
  font-size: 19rpx;
  color: #6f8fa0;
}

.quote-more {
  font-size: 19rpx;
  color: #8d95ad;
  font-family: monospace;
}

.load-more {
  margin-top: 8rpx;
  padding: 22rpx 0;
  border: 1rpx solid rgba(255, 200, 87, 0.28);
  border-radius: 14rpx;
  text-align: center;
  font-size: 23rpx;
  color: #ffc857;
}
