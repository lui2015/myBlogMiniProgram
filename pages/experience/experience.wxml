<view class="page">

  <view class="hero">
    <view class="hero-grid"></view>
    <text class="hero-title">EXPERIENCE</text>
    <text class="hero-sub">// 经验沉淀 · 站点同步</text>
    <text class="hero-stats">{{total}} 篇经验 · {{categories.length}} 个分类</text>
    <view class="hero-line"></view>
  </view>

  <view wx:if="{{loading}}" class="state">
    <text class="state-text">正在同步经验库…</text>
  </view>
  <view wx:elif="{{errorMsg}}" class="state">
    <text class="state-text">{{errorMsg}}</text>
    <view class="state-retry" bindtap="retry">重新加载</view>
  </view>

  <block wx:else>
    <view wx:if="{{stale}}" class="offline-tip">网络不可用 · 显示本机缓存内容</view>

    <view class="search-box">
      <text class="search-icon">⌕</text>
      <input
        class="search-input"
        type="text"
        value="{{keyword}}"
        placeholder="搜索标题、简介或正文"
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onSearchInput"
      />
      <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">✕</text>
    </view>

    <scroll-view class="cat-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="cat-list">
        <view
          class="cat-tab {{category === item.id ? 'active' : ''}}"
          wx:for="{{tabs}}"
          wx:key="id"
          bindtap="onCategoryTap"
          data-id="{{item.id}}"
        >{{item.name}}</view>
      </view>
    </scroll-view>

    <view class="sec-header">
      <text class="sec-icon">◈</text>
      <text class="sec-title">EXPERIENCE LIST · {{list.length}}</text>
      <view class="sec-line"></view>
    </view>

    <view wx:if="{{list.length}}" class="card-list">
      <view
        class="exp-card"
        wx:for="{{list}}"
        wx:key="id"
        bindtap="openDetail"
        data-id="{{item.id}}"
      >
        <view class="card-top">
          <text class="card-no">{{item.no}}</text>
          <text class="card-cat">{{item.categoryName}}</text>
        </view>
        <text class="card-title">{{item.title}}</text>
        <text wx:if="{{item.summary}}" class="card-summary">{{item.summary}}</text>
        <text wx:if="{{item.snippet}}" class="card-snippet">命中正文：{{item.snippet}}</text>
        <view class="card-foot">
          <text wx:if="{{item.date}}" class="card-meta">{{item.date}}</text>
          <text wx:if="{{item.sizeText}}" class="card-meta">· {{item.sizeText}}</text>
          <text class="card-arrow">阅读全文 →</text>
        </view>
      </view>
    </view>
    <view wx:else class="state">
      <text class="state-text">没有匹配的经验，换个关键词或分类试试</text>
    </view>

    <view class="tip-card">
      <text class="tip-title">◈ 数据来源</text>
      <text class="tip-text">分类与经验列表来自站点公开的只读接口，正文由接口返回的 HTML 清洗后用原生组件渲染。搜索支持标题、简介与服务端全文检索。数据仅在本机缓存，下拉刷新可同步最新内容；不登录、不上传、不跳转站外链接。</text>
    </view>
  </block>

  <button class="share-entry" open-type="share" hover-class="share-entry-hover">
    <text class="share-icon">↗</text>
    <text class="share-main">转发给朋友</text>
    <text class="share-sub">SHARE</text>
    <text class="share-arrow">→</text>
  </button>

</view>
