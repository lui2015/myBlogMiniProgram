<view class="page">

  <view class="articles-hero">
    <text class="articles-title">ARTICLES</text>
    <text class="articles-sub">// 全部文章 · 长文记录与思考</text>
  </view>

  <view class="search-bar">
    <text class="search-icon">⌕</text>
    <input
      class="search-input"
      placeholder="搜索文章标题 / 分类 / 标签"
      placeholder-class="search-ph"
      value="{{keyword}}"
      bindinput="onSearchInput"
      confirm-type="search"
    ></input>
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">✕</text>
  </view>

  <view class="result-count">{{countText}}</view>

  <view wx:if="{{loading}}" class="state"><text class="state-text">正在加载文章…</text></view>

  <view wx:elif="{{error}}" class="state">
    <text class="state-text">{{error}}</text>
    <view class="state-retry" bindtap="onRetry">重新加载</view>
  </view>

  <view wx:elif="{{!works.length}}" class="state">
    <text class="state-text">{{keyword ? '没有找到相关文章' : '暂无文章'}}</text>
  </view>

  <view wx:else class="list">
    <view class="work-card" wx:for="{{works}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image class="work-cover" src="{{item.cover}}" mode="aspectFill" lazy-load binderror="onCoverError" data-index="{{index}}"></image>
      <view class="work-body">
        <view class="work-meta">
          <text class="cy-tag">{{item.category}}</text>
          <text class="work-date">{{item.date}}</text>
        </view>
        <text class="work-title">{{item.title}}</text>
        <text class="work-excerpt">{{item.excerpt}}</text>
        <view class="work-foot">
          <text class="work-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">#{{tag}}</text>
          <text class="work-readtime">{{item.readTime}}</text>
        </view>
      </view>
    </view>
    <view class="list-end">— 已加载全部 {{works.length}} 篇 —</view>
  </view>

  <button class="share-entry" open-type="share" hover-class="share-entry-hover">
    <text class="share-icon">↗</text>
    <text class="share-main">转发给朋友</text>
    <text class="share-sub">SHARE</text>
    <text class="share-arrow">→</text>
  </button>

</view>
