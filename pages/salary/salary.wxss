page {
  background: #0a0a14;
}

.page {
  min-height: 100vh;
  padding: 0 30rpx 60rpx;
  box-sizing: border-box;
  color: #ffffff;
  background:
    radial-gradient(circle at 88% -8%, rgba(0, 212, 255, 0.18), transparent 48%),
    radial-gradient(circle at 4% 20%, rgba(61, 220, 151, 0.06), transparent 44%),
    #0a0a14;
}

/* Hero */
.hero {
  padding: 54rpx 8rpx 30rpx;
}

.hero-kicker {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #00d4ff;
}

.hero-title {
  margin-top: 14rpx;
  font-size: 60rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8d95ad;
}

/* 输入面板 */
.panel {
  padding: 32rpx 26rpx 28rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.22);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.035);
}

.section-en {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #00d4ff;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  background: rgba(10, 16, 30, 0.6);
}

.input-label {
  width: 64rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #c9d2e6;
}

.amount-input {
  flex: 1;
  min-width: 0;
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
}

.input-placeholder {
  font-size: 24rpx;
  font-weight: 400;
  color: #5c6780;
}

.input-unit {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #8d95ad;
}

.input-hint {
  margin-top: 18rpx;
  font-size: 20rpx;
  line-height: 1.7;
  color: #7f8aa3;
}

.mode-title {
  margin-top: 36rpx;
}

.mode-row {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.mode-btn {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.03);
}

.mode-btn.active {
  border-color: #00d4ff;
  background: rgba(0, 212, 255, 0.14);
}

.mode-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #eef2ff;
}

.mode-btn.active .mode-name {
  color: #00d4ff;
}

.mode-hint {
  font-size: 19rpx;
  color: #8d95ad;
}

/* 单位薪酬 */
.section-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin: 40rpx 8rpx 18rpx;
}

.section-cn {
  font-size: 22rpx;
  color: #8d95ad;
}

.rate-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.rate-cell {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: calc((100% - 16rpx) / 2);
  box-sizing: border-box;
  padding: 26rpx 22rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.18);
  border-radius: 18rpx;
  background: linear-gradient(145deg, rgba(0, 212, 255, 0.09), rgba(14, 22, 40, 0.85));
}

.rate-label {
  font-size: 21rpx;
  color: #8d95ad;
}

.rate-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
  word-break: break-all;
}

/* 实时累计 */
.live-card {
  margin-top: 32rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.4);
  border-radius: 24rpx;
  background: linear-gradient(150deg, rgba(0, 212, 255, 0.18), rgba(10, 18, 34, 0.95));
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.25);
}

.live-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.live-eyebrow {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #00d4ff;
}

.live-clock {
  font-size: 24rpx;
  color: #a7b0c6;
}

.live-amount {
  margin-top: 26rpx;
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #ffffff;
  word-break: break-all;
}

.live-sub {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #8d95ad;
}

.live-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 30rpx;
}

.live-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 14rpx;
  background: linear-gradient(90deg, #00d4ff, #3ddc97);
  color: #06121a;
  font-size: 23rpx;
  font-weight: 700;
}

.live-btn.ghost {
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.04);
  color: #c9d2e6;
}

.foot-note {
  margin-top: 40rpx;
  font-size: 19rpx;
  line-height: 1.8;
  color: #626c85;
  text-align: center;
}
