page {
  background: #0a0a14;
}

.page {
  min-height: 100vh;
  padding: 0 30rpx 60rpx;
  box-sizing: border-box;
  color: #ffffff;
  background:
    radial-gradient(circle at 88% -8%, rgba(61, 220, 151, 0.16), transparent 48%),
    radial-gradient(circle at 4% 16%, rgba(0, 212, 255, 0.08), transparent 44%),
    #0a0a14;
}

/* Hero */
.hero {
  padding: 54rpx 8rpx 30rpx;
}

.hero-kicker {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #3ddc97;
}

.hero-title {
  margin-top: 14rpx;
  font-size: 62rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8d95ad;
}

.stat-bar {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid rgba(61, 220, 151, 0.16);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.03);
  font-size: 21rpx;
  color: #a7b0c6;
}

/* 进度 */
.progress-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 14rpx;
  font-size: 22rpx;
  color: #a7b0c6;
}

.progress-track {
  height: 8rpx;
  margin-bottom: 30rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #3ddc97, #00d4ff);
  transition: width 0.25s ease;
}

/* 单词卡 */
.word-card {
  padding: 46rpx 32rpx 40rpx;
  border: 1rpx solid rgba(61, 220, 151, 0.28);
  border-radius: 22rpx;
  background: linear-gradient(145deg, rgba(61, 220, 151, 0.12), rgba(14, 22, 40, 0.9));
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.25);
  text-align: center;
}

.word-pos {
  display: block;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #3ddc97;
}

.word-text {
  display: block;
  margin: 18rpx 0 10rpx;
  font-size: 70rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  word-break: break-all;
}

.word-phonetic {
  display: block;
  font-size: 26rpx;
  color: #a7b0c6;
}

.word-copy {
  display: inline-block;
  margin-top: 26rpx;
  padding: 10rpx 24rpx;
  border: 1rpx solid rgba(61, 220, 151, 0.35);
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #3ddc97;
}

.section-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin: 40rpx 8rpx 18rpx;
}

.section-en {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #3ddc97;
}

.section-cn {
  font-size: 22rpx;
  color: #8d95ad;
}

/* 选项 */
.options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.045);
  transition: all 0.18s ease;
}

.option-key {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: rgba(61, 220, 151, 0.12);
  color: #3ddc97;
  font-size: 22rpx;
  font-weight: 700;
}

.option-text {
  font-size: 28rpx;
  color: #eef2ff;
}

.option.right {
  border-color: #3ddc97;
  background: rgba(61, 220, 151, 0.16);
}

.option.right .option-key {
  background: #3ddc97;
  color: #07160f;
}

.option.wrong {
  border-color: #ff6b6b;
  background: rgba(255, 107, 107, 0.14);
}

.option.wrong .option-key {
  background: #ff6b6b;
  color: #1a0808;
}

.option.dim {
  opacity: 0.42;
}

/* 答题反馈 */
.feedback {
  margin-top: 26rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
}

.feedback.ok {
  border-color: rgba(61, 220, 151, 0.4);
}

.feedback.no {
  border-color: rgba(255, 107, 107, 0.4);
}

.feedback-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #3ddc97;
}

.feedback.no .feedback-title {
  color: #ff8f8f;
}

.feedback-word {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #dfe6f5;
}

.feedback-example {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #8d95ad;
}

.next-btn {
  height: 76rpx;
  margin-top: 24rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #3ddc97, #00d4ff);
  color: #06121a;
  font-size: 26rpx;
  font-weight: 800;
}

/* 结算 */
.result-card {
  margin-top: 40rpx;
  padding: 50rpx 30rpx 36rpx;
  border: 1rpx solid rgba(61, 220, 151, 0.3);
  border-radius: 24rpx;
  background: linear-gradient(150deg, rgba(61, 220, 151, 0.16), rgba(14, 22, 40, 0.92));
  text-align: center;
}

.result-eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #3ddc97;
}

.result-score {
  margin-top: 16rpx;
  font-size: 110rpx;
  font-weight: 800;
  line-height: 1.2;
}

.result-total {
  font-size: 40rpx;
  font-weight: 500;
  color: #8d95ad;
}

.result-label {
  font-size: 22rpx;
  color: #a7b0c6;
}

.result-record {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #ffd166;
}

.result-grid {
  display: flex;
  margin-top: 36rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.09);
}

.result-cell {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.cell-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #3ddc97;
}

.cell-label {
  font-size: 20rpx;
  color: #8d95ad;
}

.wrong-card {
  margin-top: 26rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
}

.wrong-title {
  margin-bottom: 18rpx;
  font-size: 23rpx;
  color: #a7b0c6;
}

.wrong-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.wrong-chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 107, 107, 0.12);
  color: #ff9c9c;
  font-size: 22rpx;
}

.result-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 36rpx;
}

.primary-btn,
.ghost-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.primary-btn {
  background: linear-gradient(90deg, #3ddc97, #00d4ff);
  color: #06121a;
}

.ghost-btn {
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  color: #c9d2e6;
}

.foot-note {
  margin-top: 40rpx;
  font-size: 19rpx;
  line-height: 1.8;
  color: #626c85;
  text-align: center;
}
