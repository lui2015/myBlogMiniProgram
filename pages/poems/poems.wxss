.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 60rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(168, 85, 247, 0.2);
  border-radius: 38rpx;
}

.search-icon {
  font-size: 34rpx;
  color: #a855f7;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #ffffff;
  height: 76rpx;
}

.search-ph {
  color: #6a6a7a;
}

.search-clear {
  font-size: 26rpx;
  color: #8a8a9a;
  padding: 0 8rpx;
}

.result-count {
  font-size: 21rpx;
  color: #6a6a7a;
  font-family: monospace;
  margin: 28rpx 0 20rpx;
}

.poem-card {
  position: relative;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, rgba(168, 85, 247, 0.06), rgba(0, 212, 255, 0.04));
  border: 1rpx solid rgba(168, 85, 247, 0.15);
  border-radius: 14rpx;
}

.poem-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.poem-title {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: bold;
}

.poem-author {
  font-size: 21rpx;
  color: #a855f7;
}

.poem-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 12rpx;
}

.poem-line {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 2;
  letter-spacing: 2rpx;
}

.poem-foot {
  font-size: 20rpx;
  color: #6a6a7a;
  font-family: monospace;
  text-align: right;
}

.poem-corner {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-color: rgba(168, 85, 247, 0.7);
  border-style: solid;
}

.poem-corner.tl { top: 10rpx; left: 10rpx; border-width: 2rpx 0 0 2rpx; }
.poem-corner.br { bottom: 10rpx; right: 10rpx; border-width: 0 2rpx 2rpx 0; }
