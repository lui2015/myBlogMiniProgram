.page {
  min-height: 100vh;
  padding: 0 32rpx 80rpx;
}

.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 -32rpx;
  padding: 48rpx 32rpx 36rpx;
  overflow: hidden;
  background: radial-gradient(ellipse at 50% 0%, #141a33 0%, #0a0a14 78%);
}

.hero-grid {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx);
  background-size: 44rpx 44rpx;
}

.hero-title {
  position: relative;
  font-size: 42rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  color: #ffffff;
  text-shadow: -3rpx 0 #ff2d95, 3rpx 0 #00d4ff;
}

.hero-sub {
  position: relative;
  font-size: 21rpx;
  color: #7a7a96;
  font-family: monospace;
  margin-top: 12rpx;
}

/* 模式切换 */
.mode-tabs {
  display: flex;
  margin: 32rpx 0 24rpx;
  padding: 6rpx;
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 8rpx;
  font-size: 23rpx;
  color: #8a8a9a;
  border-radius: 8rpx;
}

.mode-tab.active {
  color: #00d4ff;
  background-color: rgba(0, 212, 255, 0.12);
  border: 1rpx solid rgba(0, 212, 255, 0.3);
  font-weight: bold;
}

/* 表单 */
.panel {
  padding-bottom: 20rpx;
}

.field-row {
  display: flex;
  justify-content: space-between;
}

.field {
  width: 48%;
}

.field-label {
  display: block;
  font-size: 21rpx;
  color: #8a8a9a;
  margin-bottom: 12rpx;
}

.picker-value,
.num-input {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  font-size: 25rpx;
  color: #ffffff;
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(0, 212, 255, 0.2);
  border-radius: 10rpx;
  box-sizing: border-box;
}

.num-input {
  height: 76rpx;
}

.input-ph {
  color: #5a5a6a;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 4rpx 8rpx;
}

.switch-label {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.75);
}

.preset-label {
  font-size: 21rpx;
  color: #6a6a7a;
  margin: 24rpx 0 14rpx;
}

.preset-row {
  display: flex;
  flex-wrap: wrap;
}

.preset-btn {
  padding: 12rpx 24rpx;
  margin: 0 14rpx 14rpx 0;
  font-size: 22rpx;
  color: #00d4ff;
  background-color: rgba(0, 212, 255, 0.06);
  border: 1rpx solid rgba(0, 212, 255, 0.25);
  border-radius: 8rpx;
}

.preset-btn:active {
  background-color: rgba(0, 212, 255, 0.2);
}

/* 结果卡片 */
.result-card {
  margin-top: 24rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.08), rgba(168, 85, 247, 0.05));
  border: 1rpx solid rgba(0, 212, 255, 0.25);
  border-radius: 16rpx;
}

.result-label {
  display: block;
  font-size: 21rpx;
  color: #8a8a9a;
  font-family: monospace;
  margin-bottom: 16rpx;
}

.result-main {
  display: flex;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.result-number {
  font-size: 84rpx;
  font-weight: bold;
  color: #00d4ff;
  font-family: monospace;
  text-shadow: 0 0 24rpx rgba(0, 212, 255, 0.45);
  line-height: 1;
}

.result-unit {
  font-size: 26rpx;
  color: #ffffff;
  margin-left: 16rpx;
}

.result-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.result-item {
  width: 19%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ri-value {
  font-size: 28rpx;
  color: #ffffff;
  font-family: monospace;
}

.ri-label {
  font-size: 18rpx;
  color: #7a7a96;
  margin-top: 6rpx;
  text-align: center;
}

.result-date {
  font-size: 52rpx;
  font-weight: bold;
  color: #00d4ff;
  font-family: monospace;
  margin: 8rpx 0 16rpx;
}

.result-meta {
  display: block;
  font-size: 23rpx;
  color: #8a8a9a;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.result-action {
  margin-top: 24rpx;
  padding: 14rpx;
  text-align: center;
  font-size: 23rpx;
  color: #00d4ff;
  border: 1rpx solid rgba(0, 212, 255, 0.35);
  border-radius: 8rpx;
}

.result-action:active {
  background-color: rgba(0, 212, 255, 0.15);
}

/* 区块标题 */
.block-head {
  display: flex;
  align-items: center;
  margin: 44rpx 0 22rpx;
}

.sec-icon {
  font-size: 26rpx;
  color: #00d4ff;
  margin-right: 12rpx;
}

.sec-title {
  font-size: 23rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 3rpx;
  font-family: monospace;
}

.sec-line {
  flex: 1;
  height: 1rpx;
  margin-left: 20rpx;
  background: linear-gradient(90deg, rgba(0, 212, 255, 0.3), transparent);
}

/* 日历 */
.cal-card {
  padding: 26rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 14rpx;
}

.cal-title {
  display: block;
  font-size: 23rpx;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.cal-week,
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-week text {
  width: 14.28%;
  text-align: center;
  font-size: 20rpx;
  color: #6a6a7a;
  padding-bottom: 12rpx;
}

.cal-cell {
  width: 14.28%;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  box-sizing: border-box;
  border: 1rpx solid transparent;
  border-radius: 6rpx;
  color: #d1d1e0;
}

.cal-cell.empty {
  background: transparent;
}

.cal-cell.workday { background-color: rgba(255, 255, 255, 0.03); }
.cal-cell.weekend { background-color: rgba(255, 255, 255, 0.01); color: #5a5a6a; }
.cal-cell.holiday { background-color: rgba(168, 85, 247, 0.2); color: #e9d5ff; }
.cal-cell.makeup { background-color: rgba(255, 45, 149, 0.18); color: #ffb3d9; }
.cal-cell.in-range { border-color: rgba(0, 212, 255, 0.3); }
.cal-cell.today text { text-decoration: underline; }
.cal-cell.edge {
  background-color: rgba(0, 212, 255, 0.28);
  border-color: #00d4ff;
  color: #ffffff;
  font-weight: bold;
}

.cal-legend {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.lg {
  font-size: 19rpx;
  color: #8a8a9a;
  margin-right: 20rpx;
  margin-bottom: 8rpx;
}

.lg-workday { color: #d1d1e0; }
.lg-weekend { color: #6a6a7a; }
.lg-holiday { color: #c084fc; }
.lg-makeup { color: #ff77b0; }

/* 区间命中节假日 */
.holiday-hit {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  background-color: rgba(168, 85, 247, 0.05);
  border: 1rpx solid rgba(168, 85, 247, 0.18);
  border-radius: 12rpx;
}

.hit-title {
  display: block;
  font-size: 22rpx;
  color: #a855f7;
  margin-bottom: 14rpx;
}

.hit-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.hit-name {
  font-size: 22rpx;
  color: #ffffff;
}

.hit-date {
  font-size: 20rpx;
  color: #8a8a9a;
  font-family: monospace;
}

/* 年度节假日 */
.year-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.year-label {
  font-size: 22rpx;
  color: #8a8a9a;
  margin-right: 16rpx;
}

.year-picker {
  padding: 10rpx 24rpx;
  font-size: 23rpx;
  color: #00d4ff;
  background-color: rgba(0, 212, 255, 0.06);
  border: 1rpx solid rgba(0, 212, 255, 0.25);
  border-radius: 8rpx;
}

.source-tag {
  margin-left: auto;
  font-size: 19rpx;
  color: #6a6a7a;
}

.holiday-row {
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  background-color: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
}

.holiday-row:active {
  background-color: rgba(0, 212, 255, 0.07);
}

.hr-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.hr-name {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: bold;
}

.hr-days {
  font-size: 20rpx;
  color: #a855f7;
}

.hr-date {
  display: block;
  font-size: 21rpx;
  color: #8a8a9a;
  font-family: monospace;
}

.hr-makeup {
  display: block;
  font-size: 20rpx;
  color: #ff77b0;
  margin-top: 8rpx;
}

.foot-hint {
  display: block;
  font-size: 19rpx;
  color: #5a5a6a;
  line-height: 1.7;
  margin-top: 20rpx;
}
