/* ====== 全局容器 ====== */
.container {
  height: 100vh;
  background-color: #0a0a14;
}

/* ====== HERO 区域 ====== */
.hero-section {
  position: relative;
  padding: 80rpx 40rpx 60rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #0f1029 0%, #0a0a14 100%);
}

.hero-bg-grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    linear-gradient(rgba(0, 212, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 212, 255, 0.03) 1px, transparent 1px);
  background-size: 40rpx 40rpx;
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-greeting {
  display: block;
  font-size: 22rpx;
  color: #00d4ff;
  font-family: monospace;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  font-size: 64rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
  text-shadow: 0 0 20rpx rgba(0, 212, 255, 0.3);
}

.hero-subtitle {
  display: block;
  font-size: 32rpx;
  color: #a855f7;
  margin-bottom: 20rpx;
  letter-spacing: 4rpx;
}

.hero-motto {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  font-style: italic;
  margin-bottom: 28rpx;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
}

.hero-tag {
  font-size: 22rpx;
  color: #00d4ff;
  border: 1rpx solid rgba(0, 212, 255, 0.4);
  padding: 8rpx 20rpx;
  border-radius: 4rpx;
  margin-right: 16rpx;
  background-color: rgba(0, 212, 255, 0.05);
}

.hero-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.deco-line {
  position: absolute;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.2), transparent);
  height: 1rpx;
}

.line1 { top: 30rpx; left: 0; right: 0; }
.line2 { bottom: 20rpx; left: 0; right: 0; }

.deco-dot {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #00d4ff;
  box-shadow: 0 0 10rpx #00d4ff;
}

.dot1 { top: 26rpx; right: 60rpx; }
.dot2 { bottom: 16rpx; left: 40rpx; }

/* ====== 内容分类 ====== */
.category-section {
  padding-top: 20rpx;
  padding-bottom: 0;
}

.category-grid {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.category-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 16rpx 28rpx;
  background: linear-gradient(180deg, rgba(0, 212, 255, 0.06) 0%, rgba(0, 0, 0, 0) 100%);
  border: 1rpx solid rgba(0, 212, 255, 0.15);
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
}

.category-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #00d4ff, transparent);
}

.category-card:active {
  background: rgba(0, 212, 255, 0.1);
  border-color: rgba(0, 212, 255, 0.4);
}

.category-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  position: relative;
}

.category-icon-wrapper::before {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  border: 1rpx solid rgba(0, 212, 255, 0.3);
  transform: rotate(45deg);
  border-radius: 8rpx;
}

.category-icon-wrapper::after {
  content: '';
  position: absolute;
  width: 70%;
  height: 70%;
  border: 1rpx solid rgba(168, 85, 247, 0.25);
  transform: rotate(45deg);
  border-radius: 6rpx;
}

.category-icon {
  font-size: 36rpx;
  position: relative;
  z-index: 1;
}

.category-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
}

.category-count {
  font-size: 20rpx;
  color: #00d4ff;
  font-family: monospace;
  margin-top: 6rpx;
}

/* ====== 通用 Section ====== */
.section {
  padding: 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.section-icon {
  font-size: 28rpx;
  color: #00d4ff;
  margin-right: 12rpx;
}

.section-title {
  font-size: 24rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 3rpx;
  font-family: monospace;
}

.section-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(0, 212, 255, 0.3), transparent);
  margin-left: 20rpx;
}

/* ====== 数据统计 ====== */
.stats-section {
  background: linear-gradient(180deg, transparent, rgba(0, 212, 255, 0.02));
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 8rpx;
  background-color: rgba(255, 255, 255, 0.02);
  border: 1rpx solid rgba(0, 212, 255, 0.1);
  border-radius: 12rpx;
}

.stat-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #00d4ff;
  font-family: monospace;
  text-shadow: 0 0 10rpx rgba(0, 212, 255, 0.5);
}

.stat-label {
  font-size: 20rpx;
  color: #8a8a9a;
  margin-top: 4rpx;
}

/* ====== 诗词模块 ====== */
.poem-card {
  position: relative;
  padding: 40rpx;
  background: linear-gradient(135deg, rgba(168, 85, 247, 0.05), rgba(0, 212, 255, 0.05));
  border: 1rpx solid rgba(168, 85, 247, 0.15);
  border-radius: 12rpx;
}

.poem-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.poem-title {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: bold;
}

.poem-author {
  font-size: 22rpx;
  color: #a855f7;
}

.poem-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.poem-line {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 2.2;
  letter-spacing: 2rpx;
}

.poem-footer {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}

.poem-btn {
  padding: 12rpx 32rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.4);
  border-radius: 30rpx;
  background-color: rgba(0, 212, 255, 0.05);
}

.poem-btn:active {
  background-color: rgba(0, 212, 255, 0.15);
}

.poem-btn-text {
  font-size: 24rpx;
  color: #00d4ff;
}

.poem-corner {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-color: rgba(0, 212, 255, 0.5);
  border-style: solid;
}

.poem-corner.tl { top: 0; left: 0; border-width: 2rpx 0 0 2rpx; }
.poem-corner.tr { top: 0; right: 0; border-width: 2rpx 2rpx 0 0; }
.poem-corner.bl { bottom: 0; left: 0; border-width: 0 0 2rpx 2rpx; }
.poem-corner.br { bottom: 0; right: 0; border-width: 0 2rpx 2rpx 0; }

/* ====== 照片模块 ====== */
.photo-card {
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 212, 255, 0.15);
}

.photo-img {
  width: 100%;
  height: 400rpx;
  display: block;
}

.photo-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
}

.photo-title {
  display: block;
  font-size: 30rpx;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.photo-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.photo-frame-corner {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border-color: #00d4ff;
  border-style: solid;
  z-index: 2;
}

.photo-frame-corner.tl { top: 12rpx; left: 12rpx; border-width: 2rpx 0 0 2rpx; }
.photo-frame-corner.tr { top: 12rpx; right: 12rpx; border-width: 2rpx 2rpx 0 0; }
.photo-frame-corner.bl { bottom: 12rpx; left: 12rpx; border-width: 0 0 2rpx 2rpx; }
.photo-frame-corner.br { bottom: 12rpx; right: 12rpx; border-width: 0 2rpx 2rpx 0; }

.photo-scanline {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.6), transparent);
  animation: scanline 3s linear infinite;
}

@keyframes scanline {
  0% { top: 0; }
  100% { top: 100%; }
}

/* ====== 视频模块 ====== */
.video-card {
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 212, 255, 0.15);
  background-color: rgba(255, 255, 255, 0.02);
}

.video-player {
  width: 100%;
  height: 380rpx;
}

.video-info {
  padding: 20rpx 24rpx;
}

.video-title {
  display: block;
  font-size: 28rpx;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.video-desc {
  display: block;
  font-size: 22rpx;
  color: #8a8a9a;
}

/* ====== 技能雷达 ====== */
.skill-list {
  display: flex;
  flex-direction: column;
}

.skill-item {
  margin-bottom: 24rpx;
}

.skill-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.skill-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.skill-percent {
  font-size: 22rpx;
  color: #00d4ff;
  font-family: monospace;
}

.skill-bar-bg {
  position: relative;
  height: 12rpx;
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 6rpx;
  overflow: hidden;
}

.skill-bar-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background: linear-gradient(90deg, #00d4ff, #a855f7);
  border-radius: 6rpx;
  transition: width 1s ease;
}

.skill-bar-glow {
  position: absolute;
  top: -2rpx;
  left: 0;
  height: calc(100% + 4rpx);
  background: linear-gradient(90deg, rgba(0, 212, 255, 0.3), rgba(168, 85, 247, 0.3));
  border-radius: 6rpx;
  filter: blur(4rpx);
}

/* ====== 最新文章 ====== */
.article-list {
  display: flex;
  flex-direction: column;
}

.article-card {
  display: flex;
  align-items: flex-start;
  padding: 28rpx;
  margin-bottom: 20rpx;
  background-color: rgba(255, 255, 255, 0.02);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  border-left: 4rpx solid rgba(0, 212, 255, 0.5);
}

.article-card:active {
  background-color: rgba(0, 212, 255, 0.05);
  border-left-color: #00d4ff;
}

.article-index {
  font-size: 36rpx;
  font-weight: bold;
  color: rgba(0, 212, 255, 0.3);
  font-family: monospace;
  margin-right: 20rpx;
  min-width: 50rpx;
}

.article-body {
  flex: 1;
}

.article-meta {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.article-category {
  font-size: 20rpx;
  color: #a855f7;
  background-color: rgba(168, 85, 247, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.article-date {
  font-size: 20rpx;
  color: #6a6a7a;
}

.article-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.article-summary {
  display: block;
  font-size: 24rpx;
  color: #8a8a9a;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.article-tags {
  display: flex;
  align-items: center;
}

.article-tag {
  font-size: 20rpx;
  color: rgba(0, 212, 255, 0.7);
  margin-right: 12rpx;
}

.article-readtime {
  font-size: 20rpx;
  color: #6a6a7a;
  margin-left: auto;
}

.article-arrow {
  font-size: 32rpx;
  color: rgba(0, 212, 255, 0.4);
  margin-left: 12rpx;
  align-self: center;
}

/* ====== 随机引言 ====== */
.quote-card {
  position: relative;
  padding: 36rpx 40rpx;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.03), rgba(168, 85, 247, 0.03));
  border-left: 4rpx solid #a855f7;
  border-radius: 0 12rpx 12rpx 0;
}

.quote-mark {
  position: absolute;
  top: -10rpx;
  left: 20rpx;
  font-size: 100rpx;
  color: rgba(168, 85, 247, 0.15);
  font-family: serif;
  line-height: 1;
}

.quote-text {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.8;
  font-style: italic;
  position: relative;
  z-index: 1;
}

.quote-author {
  display: block;
  font-size: 22rpx;
  color: #a855f7;
  margin-top: 16rpx;
  text-align: right;
}

/* ====== 底部 ====== */
.footer {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-line {
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.5), transparent);
  margin-bottom: 24rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #6a6a7a;
  margin-bottom: 8rpx;
}

.footer-link {
  font-size: 22rpx;
  color: rgba(0, 212, 255, 0.5);
}
