.page {
  min-height: 100vh;
  background-color: #0a0a14;
}

/* ====== HERO ====== */
.hero {
  position: relative;
  padding: 60rpx 40rpx 56rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #0f1029 0%, #0a0a14 100%);
}

.hero-grid {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(0, 212, 255, 0.035) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(0, 212, 255, 0.035) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
}

.hero-body {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.hero-avatar-wrap {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  padding: 4rpx;
  background: linear-gradient(135deg, #00d4ff, #a855f7);
  margin-right: 32rpx;
  flex-shrink: 0;
}

.hero-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  background-color: #15152a;
}

.hero-avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #ffffff;
  font-weight: bold;
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-greeting {
  display: block;
  font-size: 20rpx;
  color: #00d4ff;
  font-family: monospace;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 12rpx;
  text-shadow: 0 0 20rpx rgba(0, 212, 255, 0.35);
}

.hero-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  line-height: 1.6;
}

.hero-deco {
  position: absolute;
  left: 0; right: 0; bottom: 16rpx;
  height: 1rpx;
  pointer-events: none;
}

.deco-line {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.25), transparent);
}

.deco-dot {
  position: absolute;
  right: 60rpx;
  top: -4rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #00d4ff;
  box-shadow: 0 0 10rpx #00d4ff;
}

/* ====== 分类导览 CATEGORY GUIDE ====== */
.guide-section {
  padding-top: 32rpx;
  padding-bottom: 28rpx;
}

.guide-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.guide-head-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.guide-head-icon {
  font-size: 26rpx;
  color: #00d4ff;
  margin-right: 12rpx;
}

.guide-head-title {
  font-size: 23rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.72);
  letter-spacing: 3rpx;
  font-family: monospace;
}

.guide-head-line {
  flex: 1;
  height: 1rpx;
  margin: 0 20rpx;
  background: linear-gradient(90deg, rgba(0, 212, 255, 0.3), transparent);
}

.guide-head-more {
  font-size: 21rpx;
  color: #00d4ff;
  flex-shrink: 0;
}

.guide-head-more:active { opacity: 0.7; }

.guide-scroll {
  width: 100%;
  white-space: nowrap;
}

.guide-list { display: inline-flex; }

.guide-card {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 248rpx;
  height: 264rpx;
  margin-right: 20rpx;
  padding: 22rpx 20rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  white-space: normal;
  background: linear-gradient(150deg, rgba(0, 212, 255, 0.09), rgba(12, 16, 32, 0.6));
  border: 1rpx solid rgba(0, 212, 255, 0.22);
  border-radius: 14rpx;
  overflow: hidden;
}

.guide-card.purple {
  background: linear-gradient(150deg, rgba(168, 85, 247, 0.1), rgba(12, 16, 32, 0.6));
  border-color: rgba(168, 85, 247, 0.26);
}

.guide-card.pink {
  background: linear-gradient(150deg, rgba(255, 45, 149, 0.09), rgba(12, 16, 32, 0.6));
  border-color: rgba(255, 45, 149, 0.24);
}

.guide-card::before {
  content: '';
  position: absolute;
  top: 0; left: 20rpx; right: 20rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.7), transparent);
}

.guide-card.purple::before {
  background: linear-gradient(90deg, transparent, rgba(168, 85, 247, 0.7), transparent);
}

.guide-card.pink::before {
  background: linear-gradient(90deg, transparent, rgba(255, 45, 149, 0.7), transparent);
}

.guide-card:active { transform: scale(0.98); }

.guide-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.guide-no {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.35);
  font-family: monospace;
}

.guide-icon { font-size: 34rpx; }

.guide-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  margin-top: 16rpx;
}

.guide-en {
  display: block;
  font-size: 18rpx;
  color: #00d4ff;
  font-family: monospace;
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}

.guide-card.purple .guide-en { color: #a855f7; }
.guide-card.pink .guide-en { color: #ff2d95; }

.guide-desc {
  display: block;
  flex: 1;
  font-size: 20rpx;
  color: #8a8a9a;
  line-height: 1.5;
  margin-top: 12rpx;
}

.guide-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.guide-count {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
  font-family: monospace;
}

.guide-enter {
  font-size: 19rpx;
  color: #00d4ff;
}

.guide-tip {
  display: block;
  margin-top: 18rpx;
  font-size: 19rpx;
  color: #5a5a6a;
  text-align: center;
}

/* ====== 通用四角装饰 ====== */
.corner {
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  border-color: rgba(0, 212, 255, 0.75);
  border-style: solid;
  z-index: 3;
}

.corner.tl { top: 10rpx; left: 10rpx; border-width: 2rpx 0 0 2rpx; }
.corner.tr { top: 10rpx; right: 10rpx; border-width: 2rpx 2rpx 0 0; }
.corner.bl { bottom: 10rpx; left: 10rpx; border-width: 0 0 2rpx 2rpx; }
.corner.br { bottom: 10rpx; right: 10rpx; border-width: 0 2rpx 2rpx 0; }

/* ====== 照片 ====== */
.photo-swiper {
  height: 380rpx;
}

.photo-card {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 212, 255, 0.15);
}

.photo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-overlay {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.88));
}

.photo-title {
  display: block;
  font-size: 30rpx;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.photo-desc {
  display: block;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.65);
}

.photo-scanline {
  position: absolute;
  left: 0; right: 0;
  top: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.7), transparent);
  animation: scan 3s linear infinite;
}

@keyframes scan {
  0% { top: 0; }
  100% { top: 100%; }
}

/* ====== 诗词 ====== */
.poem-card {
  position: relative;
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(135deg, rgba(168, 85, 247, 0.07), rgba(0, 212, 255, 0.05));
  border: 1rpx solid rgba(168, 85, 247, 0.18);
  border-radius: 12rpx;
}

.poem-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.poem-title {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: bold;
}

.poem-author {
  font-size: 22rpx;
  color: #a855f7;
}

.poem-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 16rpx;
}

.poem-line {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 2.1;
  letter-spacing: 2rpx;
}

.poem-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.poem-date {
  font-size: 20rpx;
  color: #6a6a7a;
  font-family: monospace;
}

.poem-btn {
  padding: 10rpx 28rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.4);
  border-radius: 30rpx;
  font-size: 23rpx;
  color: #00d4ff;
  background-color: rgba(0, 212, 255, 0.05);
}

.poem-btn:active {
  background-color: rgba(0, 212, 255, 0.18);
}

/* ====== 视频 ====== */
.video-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.video-card {
  position: relative;
  width: 48%;
  height: 220rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 212, 255, 0.12);
}

.video-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.video-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(transparent 30%, rgba(0, 0, 0, 0.85));
}

.video-play {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: rgba(0, 212, 255, 0.18);
  border: 1rpx solid rgba(0, 212, 255, 0.6);
  color: #00d4ff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-duration {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 20rpx;
  color: #ffffff;
  background-color: rgba(0, 0, 0, 0.6);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.video-caption {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 16rpx;
}

.video-title {
  display: block;
  font-size: 23rpx;
  color: #ffffff;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.video-meta {
  display: block;
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 4rpx;
}

.sec-sub {
  font-size: 20rpx;
  color: #6a6a7a;
  margin-left: 10rpx;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

/* ====== 技能作品 ====== */
.mskill-list {
  display: flex;
  flex-direction: column;
}

.mskill-item {
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 22rpx 20rpx;
  margin-bottom: 14rpx;
  background-color: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-left: 2rpx solid rgba(168, 85, 247, 0.5);
  border-radius: 10rpx;
}

.mskill-item:active {
  background-color: rgba(168, 85, 247, 0.08);
  border-color: rgba(168, 85, 247, 0.45);
}

.mskill-dot {
  font-size: 18rpx;
  color: #a855f7;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.mskill-name {
  font-size: 25rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.9);
  margin-right: 14rpx;
  flex-shrink: 0;
}

.mskill-desc {
  flex: 1;
  min-width: 0;
  font-size: 21rpx;
  color: #8a8a9a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mskill-arrow {
  font-size: 22rpx;
  color: rgba(168, 85, 247, 0.5);
  margin-left: 12rpx;
  flex-shrink: 0;
}

.mskill-tip {
  padding-top: 4rpx;
  font-size: 19rpx;
  color: #55556a;
  text-align: right;
}

/* ====== 最新文章 ====== */
.work-list {
  display: flex;
  flex-direction: column;
}

.work-card {
  display: flex;
  align-items: stretch;
  margin-bottom: 20rpx;
  background-color: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 14rpx;
  overflow: hidden;
}

.work-card:active {
  background-color: rgba(0, 212, 255, 0.06);
  border-color: rgba(0, 212, 255, 0.45);
}

/* 左侧封面：图片 + 渐变蒙层 + 序号 */
.work-media {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
  background-color: #10162a;
  overflow: hidden;
}

.work-cover {
  width: 100%;
  height: 100%;
  display: block;
}

/* 无封面或图片加载失败时的占位 */
.work-cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.12), rgba(168, 85, 247, 0.12));
}

.work-cover-empty-icon {
  font-size: 48rpx;
  line-height: 1;
  color: rgba(0, 212, 255, 0.55);
  margin-bottom: 12rpx;
}

.work-cover-empty-text {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #6a6a7a;
  font-family: monospace;
}

.work-media-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(4, 6, 16, 0.5), transparent 45%, rgba(4, 6, 16, 0.35));
  pointer-events: none;
}

.work-index {
  position: absolute;
  top: 12rpx;
  left: 14rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #00d4ff;
  font-family: monospace;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.85);
}

.work-body {
  flex: 1;
  min-width: 0;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.work-meta {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.work-date {
  font-size: 20rpx;
  color: #6a6a7a;
}

.work-title {
  font-size: 27rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1.35;
  margin-bottom: 6rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.work-excerpt {
  font-size: 22rpx;
  color: #8a8a9a;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.work-foot {
  display: flex;
  align-items: center;
  margin-top: auto;
  min-width: 0;
}

.work-tags {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: rgba(0, 212, 255, 0.65);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.work-readtime {
  font-size: 20rpx;
  color: #6a6a7a;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.work-arrow {
  font-size: 26rpx;
  color: rgba(0, 212, 255, 0.5);
  margin-left: 8rpx;
  flex-shrink: 0;
}

/* ====== 软件作品 ====== */
.sec-more {
  font-size: 21rpx;
  color: #00d4ff;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.sec-more:active {
  opacity: 0.7;
}

.soft-scroll {
  width: 100%;
  white-space: nowrap;
}

.soft-list {
  display: inline-flex;
}

.soft-card {
  position: relative;
  width: 320rpx;
  height: 400rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  overflow: hidden;
  background-color: #10162a;
  border: 1rpx solid rgba(0, 212, 255, 0.18);
}

.soft-card:active {
  border-color: rgba(0, 212, 255, 0.5);
}

.soft-cover {
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0.9;
}

.soft-mask {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 62%;
  background: linear-gradient(transparent, rgba(6, 9, 20, 0.97));
}

.soft-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 19rpx;
  color: #00d4ff;
  background-color: rgba(0, 212, 255, 0.15);
  border: 1rpx solid rgba(0, 212, 255, 0.4);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.soft-info {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  padding: 24rpx 20rpx;
}

.soft-name {
  display: block;
  font-size: 27rpx;
  font-weight: bold;
  color: #00d4ff;
  margin-bottom: 10rpx;
  white-space: normal;
}

.soft-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.62);
  line-height: 1.5;
  margin-bottom: 12rpx;
  white-space: normal;
}

.soft-action {
  display: block;
  font-size: 20rpx;
  color: #a855f7;
  white-space: normal;
}

.soft-corner {
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  border-color: rgba(0, 212, 255, 0.8);
  border-style: solid;
  z-index: 3;
}

.soft-corner.tl { top: 10rpx; left: 10rpx; border-width: 2rpx 0 0 2rpx; }
.soft-corner.br { bottom: 10rpx; right: 10rpx; border-width: 0 2rpx 2rpx 0; }

/* ====== 我的思考 ====== */
.quote-card {
  position: relative;
  padding: 40rpx 36rpx 32rpx;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.04), rgba(168, 85, 247, 0.04));
  border-left: 4rpx solid #a855f7;
  border-radius: 0 12rpx 12rpx 0;
}

.quote-mark {
  position: absolute;
  top: -8rpx;
  left: 18rpx;
  font-size: 96rpx;
  color: rgba(168, 85, 247, 0.16);
  font-family: serif;
  line-height: 1;
}

.quote-text {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.8;
}

.quote-author {
  display: block;
  font-size: 22rpx;
  color: #a855f7;
  margin-top: 18rpx;
  text-align: right;
}

/* ====== 底部 ====== */
.footer {
  padding: 40rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-line {
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.5), transparent);
  margin-bottom: 24rpx;
}

.footer-text {
  font-size: 21rpx;
  color: #6a6a7a;
  margin-bottom: 8rpx;
}

.footer-link {
  font-size: 21rpx;
  color: rgba(0, 212, 255, 0.5);
}
