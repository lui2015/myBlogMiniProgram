.page {
  min-height: 100vh;
  background-color: #0a0a14;
}

/* ====== HERO ====== */
.hero {
  position: relative;
  padding: 60rpx 40rpx 56rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #0f1029 0%, #0a0a14 100%);
}

.hero-grid {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(0, 212, 255, 0.035) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(0, 212, 255, 0.035) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
}

.hero-body {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.hero-avatar-wrap {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  padding: 4rpx;
  background: linear-gradient(135deg, #00d4ff, #a855f7);
  margin-right: 32rpx;
  flex-shrink: 0;
}

.hero-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  background-color: #15152a;
}

.hero-avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #ffffff;
  font-weight: bold;
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-greeting {
  display: block;
  font-size: 20rpx;
  color: #00d4ff;
  font-family: monospace;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 12rpx;
  text-shadow: 0 0 20rpx rgba(0, 212, 255, 0.35);
}

.hero-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  line-height: 1.6;
}

.hero-deco {
  position: absolute;
  left: 0; right: 0; bottom: 16rpx;
  height: 1rpx;
  pointer-events: none;
}

.deco-line {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.25), transparent);
}

.deco-dot {
  position: absolute;
  right: 60rpx;
  top: -4rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #00d4ff;
  box-shadow: 0 0 10rpx #00d4ff;
}

/* ====== 内容分类 ====== */
.category-section {
  padding-top: 28rpx;
  padding-bottom: 20rpx;
}

.category-grid {
  display: flex;
  gap: 20rpx;
}

.category-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 12rpx 26rpx;
  background: linear-gradient(180deg, rgba(0, 212, 255, 0.07), rgba(0, 0, 0, 0));
  border: 1rpx solid rgba(0, 212, 255, 0.15);
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
}

.category-card::before {
  content: '';
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  width: 60%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #00d4ff, transparent);
}

.category-card:active {
  background: rgba(0, 212, 255, 0.12);
  border-color: rgba(0, 212, 255, 0.45);
}

.category-icon-wrapper {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  position: relative;
}

.category-icon-wrapper::before,
.category-icon-wrapper::after {
  content: '';
  position: absolute;
  border-style: solid;
  border-radius: 6rpx;
  transform: rotate(45deg);
}

.category-icon-wrapper::before {
  width: 100%; height: 100%;
  border-width: 1rpx;
  border-color: rgba(0, 212, 255, 0.35);
}

.category-icon-wrapper::after {
  width: 68%; height: 68%;
  border-width: 1rpx;
  border-color: rgba(168, 85, 247, 0.28);
}

.category-icon {
  font-size: 34rpx;
  position: relative;
  z-index: 1;
}

.category-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
}

.category-count {
  font-size: 20rpx;
  color: #00d4ff;
  font-family: monospace;
  margin-top: 8rpx;
}

.quick-links {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
}

.quick-link {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  padding: 14rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.quick-link:last-child {
  margin-right: 0;
}

.quick-link:active {
  color: #00d4ff;
  border-color: rgba(0, 212, 255, 0.3);
}

/* ====== 通用四角装饰 ====== */
.corner {
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  border-color: rgba(0, 212, 255, 0.75);
  border-style: solid;
  z-index: 3;
}

.corner.tl { top: 10rpx; left: 10rpx; border-width: 2rpx 0 0 2rpx; }
.corner.tr { top: 10rpx; right: 10rpx; border-width: 2rpx 2rpx 0 0; }
.corner.bl { bottom: 10rpx; left: 10rpx; border-width: 0 0 2rpx 2rpx; }
.corner.br { bottom: 10rpx; right: 10rpx; border-width: 0 2rpx 2rpx 0; }

/* ====== 照片 ====== */
.photo-swiper {
  height: 380rpx;
}

.photo-card {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 212, 255, 0.15);
}

.photo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-overlay {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.88));
}

.photo-title {
  display: block;
  font-size: 30rpx;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.photo-desc {
  display: block;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.65);
}

.photo-scanline {
  position: absolute;
  left: 0; right: 0;
  top: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.7), transparent);
  animation: scan 3s linear infinite;
}

@keyframes scan {
  0% { top: 0; }
  100% { top: 100%; }
}

/* ====== 诗词 ====== */
.poem-card {
  position: relative;
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(135deg, rgba(168, 85, 247, 0.07), rgba(0, 212, 255, 0.05));
  border: 1rpx solid rgba(168, 85, 247, 0.18);
  border-radius: 12rpx;
}

.poem-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.poem-title {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: bold;
}

.poem-author {
  font-size: 22rpx;
  color: #a855f7;
}

.poem-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 16rpx;
}

.poem-line {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 2.1;
  letter-spacing: 2rpx;
}

.poem-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.poem-date {
  font-size: 20rpx;
  color: #6a6a7a;
  font-family: monospace;
}

.poem-btn {
  padding: 10rpx 28rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.4);
  border-radius: 30rpx;
  font-size: 23rpx;
  color: #00d4ff;
  background-color: rgba(0, 212, 255, 0.05);
}

.poem-btn:active {
  background-color: rgba(0, 212, 255, 0.18);
}

/* ====== 视频 ====== */
.video-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.video-card {
  position: relative;
  width: 48%;
  height: 220rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 212, 255, 0.12);
}

.video-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.video-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(transparent 30%, rgba(0, 0, 0, 0.85));
}

.video-play {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: rgba(0, 212, 255, 0.18);
  border: 1rpx solid rgba(0, 212, 255, 0.6);
  color: #00d4ff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-duration {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 20rpx;
  color: #ffffff;
  background-color: rgba(0, 0, 0, 0.6);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.video-caption {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 16rpx;
}

.video-title {
  display: block;
  font-size: 23rpx;
  color: #ffffff;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.video-meta {
  display: block;
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 4rpx;
}

/* ====== 技能 ====== */
.skill-item {
  margin-bottom: 24rpx;
}

.skill-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.skill-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.skill-level {
  font-size: 22rpx;
  color: #00d4ff;
  font-family: monospace;
}

.skill-track {
  height: 12rpx;
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 6rpx;
  overflow: hidden;
}

.skill-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #00d4ff, #a855f7);
  box-shadow: 0 0 12rpx rgba(0, 212, 255, 0.5);
  transition: width 0.8s ease;
}

/* ====== 最新文章 ====== */
.work-list {
  display: flex;
  flex-direction: column;
}

.work-card {
  display: flex;
  align-items: flex-start;
  padding: 26rpx;
  margin-bottom: 20rpx;
  background-color: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-left: 4rpx solid rgba(0, 212, 255, 0.5);
  border-radius: 12rpx;
}

.work-card:active {
  background-color: rgba(0, 212, 255, 0.06);
  border-left-color: #00d4ff;
}

.work-index {
  font-size: 36rpx;
  font-weight: bold;
  color: rgba(0, 212, 255, 0.3);
  font-family: monospace;
  margin-right: 20rpx;
  min-width: 52rpx;
}

.work-body {
  flex: 1;
  min-width: 0;
}

.work-meta {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.work-date {
  font-size: 20rpx;
  color: #6a6a7a;
}

.work-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.work-excerpt {
  display: block;
  font-size: 23rpx;
  color: #8a8a9a;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.work-foot {
  display: flex;
  align-items: center;
}

.work-tags {
  font-size: 20rpx;
  color: rgba(0, 212, 255, 0.65);
}

.work-readtime {
  font-size: 20rpx;
  color: #6a6a7a;
  margin-left: auto;
}

.work-arrow {
  font-size: 30rpx;
  color: rgba(0, 212, 255, 0.4);
  margin-left: 12rpx;
  align-self: center;
}

/* ====== 我的思考 ====== */
.quote-card {
  position: relative;
  padding: 40rpx 36rpx 32rpx;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.04), rgba(168, 85, 247, 0.04));
  border-left: 4rpx solid #a855f7;
  border-radius: 0 12rpx 12rpx 0;
}

.quote-mark {
  position: absolute;
  top: -8rpx;
  left: 18rpx;
  font-size: 96rpx;
  color: rgba(168, 85, 247, 0.16);
  font-family: serif;
  line-height: 1;
}

.quote-text {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.8;
}

.quote-author {
  display: block;
  font-size: 22rpx;
  color: #a855f7;
  margin-top: 18rpx;
  text-align: right;
}

/* ====== 底部 ====== */
.footer {
  padding: 40rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-line {
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.5), transparent);
  margin-bottom: 24rpx;
}

.footer-text {
  font-size: 21rpx;
  color: #6a6a7a;
  margin-bottom: 8rpx;
}

.footer-link {
  font-size: 21rpx;
  color: rgba(0, 212, 255, 0.5);
}
