<view class="page">

  <!-- ====== HERO ====== -->
  <view class="hero">
    <view class="hero-grid"></view>
    <view class="hero-body">
      <view class="hero-avatar-wrap">
        <image wx:if="{{hero.avatarUrl}}" class="hero-avatar" src="{{hero.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="hero-avatar hero-avatar--text">
          <text>{{hero.avatarText || '鲁'}}</text>
        </view>
      </view>
      <view class="hero-info">
        <text class="hero-greeting">// WELCOME TO</text>
        <text class="hero-title">{{hero.title || '鲁力铭'}}</text>
        <text class="hero-subtitle">{{hero.subtitle}}</text>
      </view>
    </view>
    <view class="hero-deco"><view class="deco-line"></view><view class="deco-dot"></view></view>
  </view>

  <!-- ====== 分类导览 CATEGORY GUIDE ====== -->
  <view class="cy-section guide-section">
    <view class="guide-head">
      <view class="guide-head-main">
        <text class="guide-head-icon">◈</text>
        <text class="guide-head-title">CATEGORY GUIDE</text>
        <view class="guide-head-line"></view>
      </view>
      <view class="guide-head-more" bindtap="goAllWorks">全部作品 →</view>
    </view>

    <scroll-view class="guide-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="guide-list">
        <view
          class="guide-card {{item.tone}}"
          wx:for="{{guides}}"
          wx:key="key"
          bindtap="goCategory"
          data-key="{{item.key}}"
        >
          <view class="guide-card-top">
            <text class="guide-no">{{item.no}}</text>
            <text class="guide-icon">{{item.icon}}</text>
          </view>
          <text class="guide-name">{{item.name}}</text>
          <text class="guide-en">{{item.en}}</text>
          <text class="guide-desc">{{item.desc}}</text>
          <view class="guide-card-foot">
            <text class="guide-count">{{item.countText}}</text>
            <text class="guide-enter">进入 →</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <text class="guide-tip">6 个内容分类 · 左右滑动查看 · 点击卡片进入对应作品页</text>
  </view>

  <!-- ====== 照片 PHOTO FRAME ====== -->
  <view class="cy-section">
    <view class="sec-header">
      <text class="sec-icon">◈</text>
      <text class="sec-title">PHOTO FRAME</text>
      <view class="sec-line"></view>
    </view>
    <swiper wx:if="{{photos.length}}" class="photo-swiper" indicator-dots indicator-color="rgba(255,255,255,0.2)" indicator-active-color="#00d4ff" circular autoplay interval="{{4500}}" duration="{{500}}">
      <swiper-item wx:for="{{photos}}" wx:key="id">
        <view class="photo-card" bindtap="previewPhoto" data-src="{{item.src}}">
          <image class="photo-img" src="{{item.src}}" mode="aspectFill" lazy-load></image>
          <view class="photo-overlay">
            <text class="photo-title">{{item.title}}</text>
            <text class="photo-desc">{{item.desc}}</text>
          </view>
          <view class="corner tl"></view><view class="corner tr"></view>
          <view class="corner bl"></view><view class="corner br"></view>
          <view class="photo-scanline"></view>
        </view>
      </swiper-item>
    </swiper>
    <view wx:elif="{{!loading}}" class="state"><text class="state-text">暂无照片数据</text></view>
  </view>

  <!-- ====== 文章作品 LATEST WORKS ====== -->
  <view class="cy-section">
    <view class="sec-header">
      <text class="sec-icon">◈</text>
      <text class="sec-title">LATEST WORKS</text>
      <view class="sec-line"></view>
    </view>
    <view wx:if="{{works.length}}" class="work-list">
      <view class="work-card" wx:for="{{works}}" wx:for-index="workIndex" wx:key="id" bindtap="goWorkDetail" data-id="{{item.id}}">
        <view class="work-media">
          <image
            wx:if="{{item.cover}}"
            class="work-cover"
            src="{{item.cover}}"
            mode="aspectFill"
            lazy-load
            binderror="onWorkCoverError"
            data-index="{{workIndex}}"
          ></image>
          <view wx:else class="work-cover-empty">
            <text class="work-cover-empty-icon">◈</text>
            <text class="work-cover-empty-text">NO COVER</text>
          </view>
          <view class="work-media-mask"></view>
          <text class="work-index">0{{workIndex + 1}}</text>
        </view>
        <view class="work-body">
          <view class="work-meta">
            <text class="cy-tag">{{item.category}}</text>
            <text class="work-date">{{item.date}}</text>
          </view>
          <text class="work-title">{{item.title}}</text>
          <text class="work-excerpt">{{item.excerpt}}</text>
          <view class="work-foot">
            <view class="work-tags">
              <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">#{{tag}} </text>
            </view>
            <text class="work-readtime">{{item.readTime}}</text>
            <text class="work-arrow">→</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:elif="{{!loading}}" class="state"><text class="state-text">暂无文章数据</text></view>
  </view>

  <!-- ====== 诗词 POETRY MODULE ====== -->
  <view class="cy-section">
    <view class="sec-header">
      <text class="sec-icon">◈</text>
      <text class="sec-title">POETRY MODULE</text>
      <view class="sec-line"></view>
    </view>
    <view wx:if="{{poem}}" class="poem-card">
      <view class="poem-head">
        <text class="poem-title">{{poem.title}}</text>
        <text class="poem-author">[{{poem.dynasty}}] {{poem.author}}</text>
      </view>
      <view class="poem-body">
        <text class="poem-line" wx:for="{{poem.lines}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="poem-foot">
        <text class="poem-date">{{poem.date}}</text>
        <view class="poem-btn" bindtap="changePoem"><text>⟳ 换一首</text></view>
      </view>
      <view class="corner tl"></view><view class="corner tr"></view>
      <view class="corner bl"></view><view class="corner br"></view>
    </view>
    <view wx:elif="{{!loading}}" class="state"><text class="state-text">暂无诗词数据</text></view>
  </view>

  <!-- ====== 我的思考 RANDOM QUOTE ====== -->
  <view class="cy-section">
    <view class="sec-header">
      <text class="sec-icon">◈</text>
      <text class="sec-title">MY THOUGHTS</text>
      <view class="sec-line"></view>
    </view>
    <view wx:if="{{quote}}" class="quote-card">
      <text class="quote-mark">"</text>
      <text class="quote-text">{{quote.text}}</text>
      <text class="quote-author">— {{quote.author}}</text>
    </view>
  </view>

  <!-- ====== 视频 VIDEO STREAM ====== -->
  <view class="cy-section">
    <view class="sec-header">
      <text class="sec-icon">◈</text>
      <text class="sec-title">VIDEO STREAM</text>
      <view class="sec-line"></view>
    </view>
    <view wx:if="{{videos.length}}" class="video-grid">
      <view class="video-card" wx:for="{{videos}}" wx:key="id" bindtap="goVideos">
        <image class="video-cover" src="{{item.cover}}" mode="aspectFill" lazy-load></image>
        <view class="video-mask"></view>
        <view class="video-play">▶</view>
        <text class="video-duration">{{item.duration}}</text>
        <view class="video-caption">
          <text class="video-title">{{item.title}}</text>
          <text class="video-meta">{{item.category}} · {{item.views}} 次观看</text>
        </view>
      </view>
    </view>
    <view wx:elif="{{!loading}}" class="state"><text class="state-text">暂无视频数据</text></view>
  </view>

  <!-- ====== 技能作品 SKILLS ====== -->
  <view wx:if="{{mySkills.length}}" class="cy-section">
    <view class="sec-header">
      <text class="sec-icon">◈</text>
      <text class="sec-title">SKILLS</text>
      <text class="sec-sub">// 技能作品</text>
      <view class="sec-line"></view>
      <view wx:if="{{mySkillsMore}}" class="sec-more" bindtap="goMySkills">查看全部 →</view>
    </view>
    <view class="mskill-list">
      <view class="mskill-item" wx:for="{{mySkills}}" wx:key="id" bindtap="onMySkillTap" data-id="{{item.id}}">
        <text class="mskill-dot">◆</text>
        <text class="mskill-name">{{item.name}}</text>
        <view class="mskill-desc">{{item.description}}</view>
        <text class="mskill-arrow">↗</text>
      </view>
    </view>
    <view class="mskill-tip">点击条目复制技能地址 · 共 {{mySkillsTotal}} 项</view>
  </view>
  <view wx:elif="{{!loading}}" class="state"><text class="state-text">暂无技能作品</text></view>

  <!-- ====== 软件作品 SOFTWARE ====== -->
  <view wx:if="{{showSoftware && softwares.length}}" class="cy-section">
    <view class="sec-header">
      <text class="sec-icon">◈</text>
      <text class="sec-title">SOFTWARE</text>
      <view class="sec-line"></view>
      <view class="sec-more" bindtap="goSoftwares">查看全部 →</view>
    </view>
    <scroll-view class="soft-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="soft-list">
        <view
          class="soft-card"
          wx:for="{{softwares}}"
          wx:key="id"
          bindtap="goSoftwares"
          data-id="{{item.id}}"
        >
          <image class="soft-cover" src="{{item.image}}" mode="aspectFill" lazy-load></image>
          <view class="soft-mask"></view>
          <text class="soft-badge">软件</text>
          <view class="soft-info">
            <text class="soft-name">{{item.name}}</text>
            <text class="soft-desc">{{item.description}}</text>
            <text class="soft-action">查看作品 ↗</text>
          </view>
          <view class="soft-corner tl"></view>
          <view class="soft-corner br"></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ====== 底部 ====== -->
  <view class="footer">
    <view class="footer-line"></view>
    <text class="footer-text">© 2026 {{hero.title || '鲁力铭'}} · 数据来源开放 API</text>
    <text class="footer-link">www.luliming.xyz</text>
  </view>

</view>
