<view class="page">

  <!-- ====== HERO ====== -->
  <view class="hero">
    <view class="hero-grid"></view>
    <view class="hero-body">
      <view class="hero-avatar-wrap">
        <image wx:if="{{hero.avatarUrl}}" class="hero-avatar" src="{{hero.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="hero-avatar hero-avatar--text">
          <text>{{hero.avatarText || '鲁'}}</text>
        </view>
      </view>
      <view class="hero-info">
        <text class="hero-greeting">// WELCOME TO</text>
        <text class="hero-title">{{hero.title || '鲁力铭'}}</text>
        <text class="hero-subtitle">{{hero.subtitle}}</text>
      </view>
    </view>
    <view class="hero-deco"><view class="deco-line"></view><view class="deco-dot"></view></view>
  </view>

  <!-- ====== 内容分类 ====== -->
  <view class="cy-section category-section">
    <view class="category-grid">
      <view class="category-card" bindtap="goCategory" data-type="article">
        <view class="category-icon-wrapper"><text class="category-icon">📝</text></view>
        <text class="category-name">文章</text>
        <text class="category-count">{{counts.article}} 篇</text>
      </view>
      <view class="category-card" bindtap="goCategory" data-type="album">
        <view class="category-icon-wrapper"><text class="category-icon">📷</text></view>
        <text class="category-name">相册</text>
        <text class="category-count">{{counts.album}} 组</text>
      </view>
      <view class="category-card" bindtap="goCategory" data-type="video">
        <view class="category-icon-wrapper"><text class="category-icon">🎬</text></view>
        <text class="category-name">视频</text>
        <text class="category-count">{{counts.video}} 个</text>
      </view>
    </view>

    <view class="quick-links">
      <view class="quick-link" bindtap="goPoems"><text>◈ 诗词</text></view>
      <view class="quick-link" bindtap="goQuotes"><text>◈ 我的思考</text></view>
      <view class="quick-link" bindtap="goAbout"><text>◈ 关于我</text></view>
    </view>
  </view>

  <!-- ====== 照片 PHOTO FRAME ====== -->
  <view class="cy-section">
    <view class="sec-header">
      <text class="sec-icon">◈</text>
      <text class="sec-title">PHOTO FRAME</text>
      <view class="sec-line"></view>
    </view>
    <swiper wx:if="{{photos.length}}" class="photo-swiper" indicator-dots indicator-color="rgba(255,255,255,0.2)" indicator-active-color="#00d4ff" circular autoplay interval="{{4500}}" duration="{{500}}">
      <swiper-item wx:for="{{photos}}" wx:key="id">
        <view class="photo-card" bindtap="previewPhoto" data-src="{{item.src}}">
          <image class="photo-img" src="{{item.src}}" mode="aspectFill" lazy-load></image>
          <view class="photo-overlay">
            <text class="photo-title">{{item.title}}</text>
            <text class="photo-desc">{{item.desc}}</text>
          </view>
          <view class="corner tl"></view><view class="corner tr"></view>
          <view class="corner bl"></view><view class="corner br"></view>
          <view class="photo-scanline"></view>
        </view>
      </swiper-item>
    </swiper>
    <view wx:elif="{{!loading}}" class="state"><text class="state-text">暂无照片数据</text></view>
  </view>

  <!-- ====== 诗词 POETRY MODULE ====== -->
  <view class="cy-section">
    <view class="sec-header">
      <text class="sec-icon">◈</text>
      <text class="sec-title">POETRY MODULE</text>
      <view class="sec-line"></view>
    </view>
    <view wx:if="{{poem}}" class="poem-card">
      <view class="poem-head">
        <text class="poem-title">{{poem.title}}</text>
        <text class="poem-author">[{{poem.dynasty}}] {{poem.author}}</text>
      </view>
      <view class="poem-body">
        <text class="poem-line" wx:for="{{poem.lines}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="poem-foot">
        <text class="poem-date">{{poem.date}}</text>
        <view class="poem-btn" bindtap="changePoem"><text>⟳ 换一首</text></view>
      </view>
      <view class="corner tl"></view><view class="corner tr"></view>
      <view class="corner bl"></view><view class="corner br"></view>
    </view>
    <view wx:elif="{{!loading}}" class="state"><text class="state-text">暂无诗词数据</text></view>
  </view>

  <!-- ====== 视频 VIDEO STREAM ====== -->
  <view class="cy-section">
    <view class="sec-header">
      <text class="sec-icon">◈</text>
      <text class="sec-title">VIDEO STREAM</text>
      <view class="sec-line"></view>
    </view>
    <view wx:if="{{videos.length}}" class="video-grid">
      <view class="video-card" wx:for="{{videos}}" wx:key="id" bindtap="goVideos">
        <image class="video-cover" src="{{item.cover}}" mode="aspectFill" lazy-load></image>
        <view class="video-mask"></view>
        <view class="video-play">▶</view>
        <text class="video-duration">{{item.duration}}</text>
        <view class="video-caption">
          <text class="video-title">{{item.title}}</text>
          <text class="video-meta">{{item.category}} · {{item.views}} 次观看</text>
        </view>
      </view>
    </view>
    <view wx:elif="{{!loading}}" class="state"><text class="state-text">暂无视频数据</text></view>
  </view>

  <!-- ====== 技能 SKILL RADAR ====== -->
  <view class="cy-section">
    <view class="sec-header">
      <text class="sec-icon">◈</text>
      <text class="sec-title">SKILL RADAR</text>
      <view class="sec-line"></view>
    </view>
    <view class="skill-list">
      <view class="skill-item" wx:for="{{skills}}" wx:key="id">
        <view class="skill-info">
          <text class="skill-name">{{item.name}}</text>
          <text class="skill-level">{{item.level}}%</text>
        </view>
        <view class="skill-track">
          <view class="skill-fill" style="width: {{item.level}}%"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- ====== 最新文章 LATEST WORKS ====== -->
  <view class="cy-section">
    <view class="sec-header">
      <text class="sec-icon">◈</text>
      <text class="sec-title">LATEST WORKS</text>
      <view class="sec-line"></view>
    </view>
    <view wx:if="{{works.length}}" class="work-list">
      <view class="work-card" wx:for="{{works}}" wx:key="id" bindtap="goWorkDetail" data-id="{{item.id}}">
        <view class="work-index">0{{index + 1}}</view>
        <view class="work-body">
          <view class="work-meta">
            <text class="cy-tag">{{item.category}}</text>
            <text class="work-date">{{item.date}}</text>
          </view>
          <text class="work-title">{{item.title}}</text>
          <text class="work-excerpt">{{item.excerpt}}</text>
          <view class="work-foot">
            <text class="work-tags" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">#{{tag}} </text>
            <text class="work-readtime">{{item.readTime}}</text>
          </view>
        </view>
        <text class="work-arrow">→</text>
      </view>
    </view>
    <view wx:elif="{{!loading}}" class="state"><text class="state-text">暂无文章数据</text></view>
  </view>

  <!-- ====== 我的思考 RANDOM QUOTE ====== -->
  <view class="cy-section">
    <view class="sec-header">
      <text class="sec-icon">◈</text>
      <text class="sec-title">MY THOUGHTS</text>
      <view class="sec-line"></view>
    </view>
    <view wx:if="{{quote}}" class="quote-card">
      <text class="quote-mark">"</text>
      <text class="quote-text">{{quote.text}}</text>
      <text class="quote-author">— {{quote.author}}</text>
    </view>
  </view>

  <!-- ====== 底部 ====== -->
  <view class="footer">
    <view class="footer-line"></view>
    <text class="footer-text">© 2026 {{hero.title || '鲁力铭'}} · 数据来源开放 API</text>
    <text class="footer-link">www.luliming.xyz</text>
  </view>

</view>
