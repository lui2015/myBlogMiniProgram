.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 80rpx;
}

.album-head {
  margin-bottom: 28rpx;
}

.album-title {
  display: block;
  font-size: 38rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.album-sub {
  display: block;
  font-size: 21rpx;
  color: #00d4ff;
  font-family: monospace;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.photo-item {
  position: relative;
  width: 48%;
  height: 240rpx;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.photo {
  width: 100%;
  height: 100%;
  display: block;
  background-color: #15152a;
}

.photo-caption {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  padding: 24rpx 14rpx 12rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
