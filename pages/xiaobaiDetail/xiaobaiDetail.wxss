.page {
  min-height: 100vh;
  padding: 0 32rpx 80rpx;
}

/* ===== Hero ===== */
.hero {
  position: relative;
  margin: 0 -32rpx;
  padding: 48rpx 32rpx 40rpx;
  overflow: hidden;
  background: radial-gradient(ellipse at 50% 0%, #141a33 0%, #0a0a14 78%);
}

.hero-grid {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx);
  background-size: 44rpx 44rpx;
}

.hero-eyebrow,
.hero-title,
.hero-summary,
.hero-meta,
.hero-tags,
.fav-btn {
  position: relative;
}

.hero-eyebrow {
  display: block;
  padding-right: 160rpx;
  font-size: 20rpx;
  color: #00d4ff;
  font-family: monospace;
  letter-spacing: 1rpx;
}

.hero-title {
  display: block;
  margin-top: 24rpx;
  font-size: 38rpx;
  font-weight: 900;
  color: #ffffff;
  line-height: 1.4;
  text-shadow: -2rpx 0 rgba(255, 45, 149, 0.7), 2rpx 0 rgba(0, 212, 255, 0.7);
}

.hero-summary {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #8a8a9a;
  line-height: 1.8;
}

.hero-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.hero-meta-item {
  font-size: 19rpx;
  color: #5a5a6a;
  font-family: monospace;
  margin-right: 24rpx;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.hero-tag {
  font-size: 19rpx;
  color: #a855f7;
  margin-right: 16rpx;
}

.fav-btn {
  position: absolute;
  top: 44rpx;
  right: 32rpx;
  padding: 10rpx 18rpx;
  font-size: 20rpx;
  color: #00d4ff;
  background-color: rgba(0, 212, 255, 0.08);
  border: 1rpx solid rgba(0, 212, 255, 0.35);
  border-radius: 26rpx;
}

.fav-btn.on {
  color: #ff2d95;
  background-color: rgba(255, 45, 149, 0.1);
  border-color: rgba(255, 45, 149, 0.4);
}

/* ===== 风险提示 / 目录 ===== */
.disclaimer {
  margin-top: 28rpx;
  padding: 18rpx 20rpx;
  font-size: 20rpx;
  color: #ffb4d2;
  line-height: 1.7;
  background-color: rgba(255, 45, 149, 0.05);
  border: 1rpx solid rgba(255, 45, 149, 0.18);
  border-radius: 10rpx;
}

.toc-card {
  margin-top: 24rpx;
  padding: 24rpx;
  background-color: rgba(168, 85, 247, 0.05);
  border: 1rpx solid rgba(168, 85, 247, 0.2);
  border-radius: 14rpx;
}

.toc-title {
  display: block;
  font-size: 22rpx;
  color: #c9a2ff;
  margin-bottom: 12rpx;
}

.toc-row {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0;
}

.toc-dot {
  font-size: 19rpx;
  color: #a855f7;
  margin-right: 12rpx;
  line-height: 1.8;
}

.toc-text {
  flex: 1;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.8;
}

/* ===== 区块头 ===== */
.section-head {
  display: flex;
  align-items: center;
  margin: 40rpx 0 20rpx;
}

.sec-icon {
  font-size: 26rpx;
  color: #00d4ff;
  margin-right: 12rpx;
}

.sec-title {
  font-size: 23rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 3rpx;
  font-family: monospace;
}

.sec-line {
  flex: 1;
  height: 1rpx;
  margin-left: 20rpx;
  background: linear-gradient(90deg, rgba(0, 212, 255, 0.3), transparent);
}

/* ===== 正文 blocks ===== */
.content {
  padding-bottom: 8rpx;
}

.blk-heading {
  display: flex;
  align-items: flex-start;
  margin: 40rpx 0 20rpx;
  padding: 20rpx 22rpx;
  background: linear-gradient(90deg, rgba(0, 212, 255, 0.12), transparent);
  border-left: 4rpx solid #00d4ff;
  border-radius: 0 10rpx 10rpx 0;
}

.blk-heading-mark {
  font-size: 24rpx;
  color: #00d4ff;
  margin-right: 14rpx;
  line-height: 1.5;
}

.blk-heading-text {
  flex: 1;
  font-size: 27rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1.5;
}

.blk-label {
  margin: 26rpx 0 12rpx;
  font-size: 21rpx;
  color: #a855f7;
  letter-spacing: 1rpx;
}

.blk-text,
.blk-step {
  display: block;
  margin-bottom: 16rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.9;
}

.blk-step {
  padding-left: 18rpx;
  border-left: 2rpx solid rgba(0, 212, 255, 0.35);
}

.blk-tip {
  margin-bottom: 18rpx;
  padding: 18rpx 20rpx;
  font-size: 23rpx;
  color: #ffffff;
  line-height: 1.8;
  background-color: rgba(168, 85, 247, 0.08);
  border: 1rpx solid rgba(168, 85, 247, 0.22);
  border-radius: 10rpx;
}

.bubble {
  display: flex;
  flex-direction: column;
  max-width: 86%;
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
}

.bubble.pig {
  align-self: flex-start;
  background-color: rgba(255, 45, 149, 0.07);
  border: 1rpx solid rgba(255, 45, 149, 0.24);
  border-bottom-left-radius: 4rpx;
}

.bubble.master {
  align-self: flex-end;
  background-color: rgba(0, 212, 255, 0.07);
  border: 1rpx solid rgba(0, 212, 255, 0.24);
  border-bottom-right-radius: 4rpx;
}

.bubble-label {
  font-size: 19rpx;
  margin-bottom: 10rpx;
}

.bubble.pig .bubble-label {
  color: #ff8ab8;
}

.bubble.master .bubble-label {
  color: #00d4ff;
}

.bubble-text {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.8;
}

/* ===== 上下篇 / 相关文章 ===== */
.sibling-row {
  display: flex;
  margin-top: 40rpx;
}

.sibling {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  background-color: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
}

.sibling:first-child {
  margin-right: 16rpx;
}

.sibling-dir {
  display: block;
  font-size: 19rpx;
  color: #00d4ff;
  margin-bottom: 10rpx;
}

.sibling-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.6;
}

.related-card {
  position: relative;
  padding: 22rpx 60rpx 22rpx 22rpx;
  margin-bottom: 16rpx;
  background-color: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 12rpx;
}

.related-card:active {
  background-color: rgba(0, 212, 255, 0.08);
}

.related-title {
  display: block;
  font-size: 23rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1.6;
}

.related-summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #7a7a96;
  line-height: 1.6;
}

.related-arrow {
  position: absolute;
  top: 50%;
  right: 22rpx;
  transform: translateY(-50%);
  font-size: 26rpx;
  color: rgba(0, 212, 255, 0.5);
}

/* ===== 底部 ===== */
.bottom-bar {
  margin-top: 44rpx;
}

.back-btn {
  padding: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #00d4ff;
  background-color: rgba(0, 212, 255, 0.06);
  border: 1rpx solid rgba(0, 212, 255, 0.3);
  border-radius: 12rpx;
}

.back-btn:active {
  background-color: rgba(0, 212, 255, 0.14);
}

.source-note {
  margin-top: 28rpx;
  font-size: 20rpx;
  color: #5a5a6a;
  line-height: 1.8;
  text-align: center;
}

/* ===== 网页原版 ===== */
.html-card {
  background-color: #ffffff;
  border: 1rpx solid rgba(0, 212, 255, 0.25);
  border-radius: 14rpx;
  overflow: hidden;
}

.html-seg {
  display: block;
}

/* 角色介绍区 */
.cast-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 30rpx 20rpx;
  background: linear-gradient(90deg, #dbeafe, #eff6ff, #dbeafe);
  border-bottom: 2rpx dashed #93c5fd;
}

.cast-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 220rpx;
}

.cast-avatar,
.dlg-avatar {
  background-color: #ffffff;
  border-radius: 50%;
  overflow: hidden;
}

.cast-avatar {
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 138, 0.16);
}

.cast-avatar-empty,
.dlg-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.cast-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #1e3a8a;
}

.cast-role {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #6b7280;
  text-align: center;
}

.cast-vs {
  font-size: 36rpx;
  font-weight: bold;
  color: #2563eb;
}

/* 对话气泡 */
.dlg-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 20rpx 20rpx;
  background-color: #ffffff;
}

.dlg-row.reverse {
  flex-direction: row-reverse;
}

.dlg-avatar {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(30, 58, 138, 0.14);
}

.dlg-bubble {
  flex: 1;
  min-width: 0;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  overflow: hidden;
}

.dlg-bubble.pig {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border: 1rpx solid #f59e0b;
  border-top-left-radius: 4rpx;
}

.dlg-bubble.master {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  border: 1rpx solid #3b82f6;
  border-top-right-radius: 4rpx;
}

