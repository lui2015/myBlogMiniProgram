<view class="page">

  <view wx:if="{{loading}}" class="state">
    <text class="state-text">正在整理这篇财经漫画…</text>
  </view>

  <view wx:elif="{{errorMsg}}" class="state">
    <text class="state-text">{{errorMsg}}</text>
    <view class="state-retry" bindtap="retry">重新加载</view>
  </view>

  <block wx:else>

    <view class="hero">
      <view class="hero-grid"></view>
      <text class="hero-eyebrow">XIAOBAI FINANCE · {{view.article.categoryName}}</text>
      <text class="hero-title">{{view.article.title}}</text>
      <text wx:if="{{view.article.summary}}" class="hero-summary">{{view.article.summary}}</text>
      <view class="hero-meta">
        <text class="hero-meta-item">{{view.article.dateText}}</text>
        <text class="hero-meta-item">👀 {{view.article.viewCount}}</text>
        <text wx:if="{{view.article.subCategoryName}}" class="hero-meta-item">{{view.article.subCategoryName}}</text>
      </view>
      <view wx:if="{{view.tags.length}}" class="hero-tags">
        <text class="hero-tag" wx:for="{{view.tags}}" wx:for-item="tag" wx:key="*this">#{{tag}}</text>
      </view>
      <view class="fav-btn {{isFav ? 'on' : ''}}" catchtap="toggleFav">{{isFav ? '★ 已收藏' : '☆ 收藏'}}</view>
    </view>

    <view class="disclaimer">{{view.disclaimer}}</view>

    <view wx:if="{{view.toc.length}}" class="toc-card">
      <text class="toc-title">◈ 本篇目录</text>
      <view class="toc-row" wx:for="{{view.toc}}" wx:for-item="toc" wx:key="text">
        <text class="toc-dot">▸</text>
        <text class="toc-text">{{toc.text}}</text>
      </view>
    </view>

    <view class="section-head">
      <text class="sec-icon">◈</text>
      <text class="sec-title">KNOWLEDGE COMIC</text>
      <view class="sec-line"></view>
    </view>

    <!-- 网页原版：正文交给 rich-text，角色头像用原生 image 显示（rich-text 只支持网络图片） -->
    <view wx:if="{{view.htmlAvailable}}" class="html-card">
      <block wx:if="{{view.segments.length}}">
        <block wx:for="{{view.segments}}" wx:for-item="seg" wx:key="key">

          <rich-text wx:if="{{seg.type === 'html'}}" class="html-seg" nodes="{{seg.html}}"></rich-text>

          <view wx:elif="{{seg.type === 'cast'}}" class="cast-row">
            <view class="cast-item">
              <image wx:if="{{seg.leftSrc}}" class="cast-avatar" src="{{seg.leftSrc}}" mode="aspectFill" binderror="onAvatarError" data-index="{{index}}" data-side="leftSrc"></image>
              <view wx:else class="cast-avatar cast-avatar-empty"><text>{{seg.leftFallback}}</text></view>
              <text class="cast-name">{{seg.left.name}}</text>
              <text wx:if="{{seg.left.role}}" class="cast-role">{{seg.left.role}}</text>
            </view>
            <text class="cast-vs">VS</text>
            <view class="cast-item">
              <image wx:if="{{seg.rightSrc}}" class="cast-avatar" src="{{seg.rightSrc}}" mode="aspectFill" binderror="onAvatarError" data-index="{{index}}" data-side="rightSrc"></image>
              <view wx:else class="cast-avatar cast-avatar-empty"><text>{{seg.rightFallback}}</text></view>
              <text class="cast-name">{{seg.right.name}}</text>
              <text wx:if="{{seg.right.role}}" class="cast-role">{{seg.right.role}}</text>
            </view>
          </view>

          <view wx:elif="{{seg.type === 'dialogue'}}" class="dlg-row {{seg.reverse ? 'reverse' : ''}}">
            <image wx:if="{{seg.src}}" class="dlg-avatar" src="{{seg.src}}" mode="aspectFill" binderror="onAvatarError" data-index="{{index}}" data-side="src"></image>
            <view wx:else class="dlg-avatar dlg-avatar-empty"><text>{{seg.fallback}}</text></view>
            <view class="dlg-bubble {{seg.reverse ? 'master' : 'pig'}}">
              <rich-text nodes="{{seg.html}}"></rich-text>
            </view>
          </view>

        </block>
      </block>
      <rich-text wx:else nodes="{{view.richHtml}}"></rich-text>
    </view>

    <!-- 接口没有 HTML 时用结构化文字兜底，避免正文空白 -->
    <block wx:else>
      <view wx:if="{{!view.blocks.length}}" class="state">
        <text class="state-text">这篇文章暂时没有可展示的文字内容。</text>
      </view>

      <view class="content">
        <block wx:for="{{view.blocks}}" wx:key="key">

          <view wx:if="{{item.type === 'heading'}}" class="blk-heading">
            <text class="blk-heading-mark">✦</text>
            <text class="blk-heading-text">{{item.text}}</text>
          </view>

          <view wx:elif="{{item.type === 'label'}}" class="blk-label">
            <text>{{item.text}}</text>
          </view>

          <view wx:elif="{{item.type === 'dialogue'}}" class="bubble {{item.role === '小白' ? 'pig' : 'master'}}">
            <text class="bubble-label">{{item.label}}</text>
            <text class="bubble-text">{{item.text}}</text>
          </view>

          <view wx:elif="{{item.type === 'tip'}}" class="blk-tip">
            <text>{{item.text}}</text>
          </view>

          <view wx:elif="{{item.type === 'step'}}" class="blk-step">
            <text>{{item.text}}</text>
          </view>

          <view wx:else class="blk-text">
            <text>{{item.text}}</text>
          </view>

        </block>
      </view>
    </block>

    <view wx:if="{{view.prev || view.next}}" class="sibling-row">
      <view wx:if="{{view.prev}}" class="sibling" bindtap="openSibling" data-id="{{view.prev.id}}">
        <text class="sibling-dir">← 上一篇</text>
        <text class="sibling-title">{{view.prev.title}}</text>
      </view>
      <view wx:if="{{view.next}}" class="sibling" bindtap="openSibling" data-id="{{view.next.id}}">
        <text class="sibling-dir">下一篇 →</text>
        <text class="sibling-title">{{view.next.title}}</text>
      </view>
    </view>

    <view wx:if="{{view.related.length}}" class="content-block">
      <view class="section-head">
        <text class="sec-icon">◈</text>
        <text class="sec-title">RELATED ARTICLES</text>
        <view class="sec-line"></view>
      </view>
      <view
        class="related-card"
        wx:for="{{view.related}}"
        wx:for-item="ref"
        wx:key="id"
        bindtap="openRelated"
        data-id="{{ref.id}}"
      >
        <text class="related-title">{{ref.title}}</text>
        <text wx:if="{{ref.summary}}" class="related-summary">{{ref.summary}}</text>
        <text class="related-arrow">→</text>
      </view>
    </view>

    <view class="bottom-bar">
      <view class="back-btn" bindtap="backToList">← 返回小白财经</view>
    </view>

    <view class="source-note">内容来自{{sourceLabel}}；正文把接口 HTML 清洗、CSS 内联后由原生 rich-text 渲染，角色头像取自文章内嵌图片并转成本机图片文件显示，不加载外部脚本与样式。正文仅在本机缓存，下拉刷新可同步最新内容。收藏仅存本机、不会上传。</view>

  </block>

</view>
