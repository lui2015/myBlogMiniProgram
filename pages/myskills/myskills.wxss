.page {
  min-height: 100vh;
  padding-bottom: 80rpx;
}

.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 52rpx 32rpx 40rpx;
  overflow: hidden;
  background: radial-gradient(ellipse at 50% 0%, #1a1433 0%, #0a0a14 78%);
}

.hero-grid {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(168, 85, 247, 0.04) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(168, 85, 247, 0.04) 1rpx, transparent 1rpx);
  background-size: 44rpx 44rpx;
}

.hero-title {
  position: relative;
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  color: #ffffff;
  text-shadow: -4rpx 0 #ff2d95, 4rpx 0 #00d4ff;
}

.hero-sub {
  position: relative;
  font-size: 21rpx;
  color: #7a7a96;
  font-family: monospace;
  margin-top: 14rpx;
}

.hero-line {
  position: relative;
  width: 140rpx;
  height: 2rpx;
  margin-top: 26rpx;
  background: linear-gradient(90deg, transparent, #a855f7, transparent);
}

.list-head {
  display: flex;
  align-items: center;
  margin: 36rpx 32rpx 24rpx;
}

.sec-icon {
  font-size: 26rpx;
  color: #a855f7;
  margin-right: 12rpx;
}

.count-text {
  font-size: 21rpx;
  color: #6a6a7a;
  font-family: monospace;
}

.sec-line {
  flex: 1;
  height: 1rpx;
  margin-left: 20rpx;
  background: linear-gradient(90deg, rgba(168, 85, 247, 0.35), transparent);
}

.skill-list {
  padding: 0 32rpx;
}

.skill-row {
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
  background-color: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-left: 3rpx solid rgba(168, 85, 247, 0.55);
  border-radius: 12rpx;
}

.skill-row:active {
  background-color: rgba(168, 85, 247, 0.08);
  border-color: rgba(168, 85, 247, 0.45);
}

.row-head {
  display: flex;
  align-items: center;
}

.row-no {
  font-size: 20rpx;
  color: #5a5a6a;
  font-family: monospace;
  margin-right: 16rpx;
}

.row-dot {
  font-size: 18rpx;
  color: #a855f7;
  margin-right: 14rpx;
}

.row-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
}

.row-copy {
  font-size: 20rpx;
  color: rgba(0, 212, 255, 0.7);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.row-desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #8a8a9a;
  line-height: 1.6;
}

.list-hint {
  padding: 0 0 24rpx;
  text-align: center;
  font-size: 20rpx;
  color: #55556a;
}
