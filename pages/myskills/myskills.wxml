<view class="page">

  <view class="hero">
    <view class="hero-grid"></view>
    <text class="hero-title">SKILLS</text>
    <text class="hero-sub">// 技能作品</text>
    <view class="hero-line"></view>
  </view>

  <view class="list-head">
    <text class="sec-icon">◈</text>
    <text class="count-text">共 {{total}} 项技能作品</text>
    <view class="sec-line"></view>
  </view>

  <view wx:if="{{keyword}}" class="search-banner">搜索「{{keyword}}」· 共 {{total}} 项结果</view>

  <view wx:if="{{loading}}" class="state"><text class="state-text">正在加载…</text></view>

  <view wx:elif="{{error}}" class="state">
    <text class="state-text">{{error}}</text>
    <view class="state-retry" bindtap="onRetry">重新加载</view>
  </view>

  <view wx:elif="{{!items.length}}" class="state">
    <text class="state-text">暂无技能作品</text>
  </view>

  <view wx:else class="skill-list">
    <view
      class="skill-row"
      wx:for="{{items}}"
      wx:key="id"
      bindtap="onItemTap"
      data-id="{{item.id}}"
    >
      <view class="row-head">
        <text class="row-no">{{index + 1}}</text>
        <text class="row-dot">◆</text>
        <text class="row-name">{{item.name}}</text>
        <text class="row-copy">复制 ↗</text>
      </view>
      <view class="row-desc">{{item.description || '暂无介绍'}}</view>
    </view>
    <view class="list-end">{{keyword ? '— 搜索结果结束 —' : '— 全部技能作品 —'}}</view>
    <view class="list-hint">点击条目可复制技能地址，小程序不跳转站外网页</view>
  </view>

</view>
