page {
  height: 100%;
  background-color: #0a0a14;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* ===== 通用区块 ===== */
.cy-section {
  padding: 40rpx;
}

.sec-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.sec-icon {
  font-size: 28rpx;
  color: #00d4ff;
  margin-right: 12rpx;
}

.sec-title {
  font-size: 24rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 3rpx;
  font-family: monospace;
}

.sec-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(0, 212, 255, 0.3), transparent);
  margin-left: 20rpx;
}

/* ===== 通用卡片 ===== */
.cy-card {
  background-color: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  overflow: hidden;
}

/* ===== 加载 / 错误 / 空状态 ===== */
.state {
  padding: 100rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.state-text {
  font-size: 26rpx;
  color: #8a8a9a;
  text-align: center;
  line-height: 1.8;
}

.state-retry {
  margin-top: 28rpx;
  padding: 12rpx 36rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.4);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #00d4ff;
}

.state-retry:active {
  background-color: rgba(0, 212, 255, 0.1);
}

/* ===== 通用标签 ===== */
.cy-tag {
  font-size: 20rpx;
  color: #a855f7;
  background-color: rgba(168, 85, 247, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
}

/* ===== 列表底部提示 ===== */
.list-end {
  padding: 32rpx 0 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: #5a5a6a;
}
